# Containerfile.cloison -- M1 scaffold of the Cloison variant image.
# Stacked on a recorded, verified parent: the daily bazzite-tower image,
# referenced ONLY by digest. This file never names a Fedora/Bazzite base.
# Plan: docs/prp/cloison-kvm-compartments.md section 4.1; status and open
# plan issues: docs/CODEMAPS/cloison.md. Local builds only (`just build-cloison`).
#
# PARENT_IMAGE is REQUIRED and must be `<repo>@sha256:<64 hex>`. The Justfile
# recipe refuses anything else up front; the RUN below is the backstop for a
# direct `podman build`.
ARG PARENT_IMAGE
ARG PARENT_SOURCE_COMMIT=unknown
ARG PARENT_PROFILE=unknown

FROM ${PARENT_IMAGE}

# ARGs declared before FROM are not visible after it; redeclare.
ARG PARENT_IMAGE
ARG PARENT_SOURCE_COMMIT
ARG PARENT_PROFILE

LABEL io.github.bearyjd.cloison.parent="${PARENT_IMAGE}" \
      io.github.bearyjd.cloison.parent-source-commit="${PARENT_SOURCE_COMMIT}" \
      io.github.bearyjd.cloison.parent-profile="${PARENT_PROFILE}"

COPY cloison/system_files/ /
COPY cloison/build.sh /usr/libexec/cloison-build/build.sh
COPY cloison/build.d/ /usr/libexec/cloison-build/build.d/

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

RUN digest="${PARENT_IMAGE##*@}"; \
    if ! [[ "${PARENT_IMAGE}" == *@sha256:* && "${digest}" =~ ^sha256:[0-9a-f]{64}$ ]]; then \
        echo "Containerfile.cloison: PARENT_IMAGE must be a digest reference <repo>@sha256:<64 hex>, got '${PARENT_IMAGE}'" >&2; \
        exit 1; \
    fi; \
    mkdir -p /usr/share/cloison; \
    printf '%s\n' "${digest}" > /usr/share/cloison/parent-digest; \
    bash /usr/libexec/cloison-build/build.sh; \
    rm -rf /usr/libexec/cloison-build

RUN bootc container lint
