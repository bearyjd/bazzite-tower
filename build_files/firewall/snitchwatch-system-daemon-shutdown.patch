+// confinedBudgetFor is what the budget must hold for total entries across all
+// lists, at most perList in one list, keyLen-byte keys and maxFile-byte files:
+// everything loaded, plus one list being reloaded (its file buffer and its
+// new entries) while its old entries are still held.
+func confinedBudgetFor(total, perList, keyLen int, maxFile int64) int64 {
+	entry := int64(keyLen + confinedEntryOverhead)
+	return int64(total)*entry + maxFile + 1 + int64(perList)*entry
+}
