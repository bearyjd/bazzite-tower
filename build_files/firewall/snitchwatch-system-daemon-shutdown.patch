@@ -0,0 +1,48 @@
+package netfilter
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+// nfq_destroy_queue() reads replies until it sees one for its unbind request,
+// but stops at the first error it reads. A stale error reply to an earlier
+// verdict made it return -1 although the kernel had unbound the queue.
+func TestTeardownDrainConsumesStaleReplies(t *testing.T) {
+	binary := filepath.Join(t.TempDir(), "queue-drain-test")
+	args := []string{"-O2", "-Wall", "-Wextra", "-Werror", "-I.", "testdata/queue_drain.c", "-lnetfilter_queue", "-lnfnetlink", "-ldl", "-pthread", "-Wl,--wrap=nfq_handle_packet,--wrap=nfq_fd,--wrap=nfq_destroy_queue", "-o", binary}
+	if out, err := exec.Command("cc", args...).CombinedOutput(); err != nil {
+		t.Fatalf("C drain test build: %v\n%s", err, out)
+	}
+	if out, err := exec.Command(binary).CombinedOutput(); err != nil {
+		t.Fatalf("C drain test: %v\n%s", err, out)
+	}
+}
+
+// The C test covers DestroyQueueDrained; this keeps Queue.destroy on it.
+func TestQueueDestroyUnbindsOnlyAfterDraining(t *testing.T) {
+	file, err := parser.ParseFile(token.NewFileSet(), "queue.go", nil, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	calls := map[string]int{}
+	for _, decl := range file.Decls {
+		if fn, ok := decl.(*ast.FuncDecl); ok && fn.Name.Name == "destroy" {
+			ast.Inspect(fn, func(n ast.Node) bool {
+				if sel, ok := n.(*ast.SelectorExpr); ok {
+					if x, ok := sel.X.(*ast.Ident); ok && x.Name == "C" {
+						calls[sel.Sel.Name]++
+					}
+				}
+				return true
+			})
+		}
+	}
+	if calls["DestroyQueueDrained"] != 1 || calls["nfq_destroy_queue"] != 0 {
+		t.Fatalf("Queue.destroy must unbind only through DestroyQueueDrained: %v", calls)
+	}
+}
diff --git a/daemon/netfilter/queue_lifetime.go b/daemon/netfilter/queue_lifetime.go
new file mode 100644
index 00000000..898efa5a
--- /dev/null
+++ b/daemon/netfilter/queue_lifetime.go
@@ -0,0 +1,41 @@
+package netfilter
+
+import "sync"
+
+// queueLifetime has one reader and one resource-release owner. Closing stop
+// unblocks callbacks; wake unblocks poll; done establishes the join before free.
+// failed closes when the reader returns without a stop request: the queue is
+// still bound, so every later packet would wait for a verdict that never comes.
+type queueLifetime struct {
+	stop     chan struct{}
+	done     chan struct{}
+	failed   chan struct{}
+	err      error // written once before failed closes
+	once     sync.Once
+	stopOnce sync.Once
+}
+
+func newQueueLifetime() *queueLifetime {
+	return &queueLifetime{stop: make(chan struct{}), done: make(chan struct{}), failed: make(chan struct{})}
+}
+func (l *queueLifetime) run(reader func()) {
+	go func() { defer close(l.done); reader() }()
+}
+
+// readerExited is called once, by the reader, as it returns.
+func (l *queueLifetime) readerExited(err error) {
+	select {
+	case <-l.stop:
+	default:
+		l.err = err
+		close(l.failed)
+	}
+}
+func (l *queueLifetime) stopAndJoin(wake func()) {
+	l.stopOnce.Do(func() { close(l.stop); wake() })
+	<-l.done
+}
+func (l *queueLifetime) close(wake, release func()) {
+	l.stopAndJoin(wake)
+	l.once.Do(release)
+}
diff --git a/daemon/netfilter/queue_reader_failure_test.go b/daemon/netfilter/queue_reader_failure_test.go
