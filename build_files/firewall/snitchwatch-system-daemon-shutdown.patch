+// Loads are limited per list path: without a record, or after a clear, a
+// load may start; otherwise it waits minConfinedReloadInterval. After budget
+// refusals a retry waits until the estimate fits, at the next poll the first
+// time, then backing off.
+func TestConfinedLoadAllowed(t *testing.T) {
+	path := "/test/confined-load-allowed/" + t.Name()
+	useBudget(t, 1000)
+	if !confinedLoadAllowed(path, 10) {
+		t.Error("unknown path refused")
+	}
+	confinedLoadDone(path, true)
+	if !confinedLoadAllowed(path, 10) {
+		t.Error("load after a clear limited")
+	}
+	confinedLoadDone(path, false)
+	if confinedLoadAllowed(path, 10) {
+		t.Error("reload not limited")
+	}
+	confinedPaths.Lock()
+	confinedPaths.m[path].lastDone = time.Now().Add(-minConfinedReloadInterval)
+	confinedPaths.Unlock()
+	confinedLoadRefused(path, 10, 500, true)
+	if !confinedLoadAllowed(path, 10) {
+		t.Error("first refusal not retried at the next poll")
+	}
+	confinedLoadRefused(path, 10, 5000, true)
+	if confinedLoadAllowed(path, 10) {
+		t.Error("retried although the estimate does not fit")
+	}
+	confinedPaths.Lock()
+	confinedPaths.m[path].lastRefused = time.Now().Add(-confinedBudgetBackoff)
+	confinedPaths.m[path].need = 100
+	confinedPaths.Unlock()
+	if !confinedLoadAllowed(path, 10) {
+		t.Error("not retried after the backoff")
+	}
+	confinedLoadRefused(path, 10, 100, true)
+	confinedPaths.Lock()
+	confinedPaths.m[path].lastRefused = time.Now().Add(-confinedBudgetBackoff)
+	confinedPaths.Unlock()
+	if confinedLoadAllowed(path, 10) {
+		t.Error("backoff did not double")
+	}
+	// a changed or removed file skips the backoff
+	if !confinedLoadAllowed(path, 20) || !confinedLoadAllowed(path, 0) {
+		t.Error("changed or removed file waited for the backoff")
+	}
+	if got := confinedLoadRefused(path, 10, 50, false); got != 100 {
+		t.Errorf("pre-parse refusal estimate %d, want the earlier 100", got)
+	}
+}
