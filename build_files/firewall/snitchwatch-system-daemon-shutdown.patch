diff --git a/daemon/drop_while_asking_test.go b/daemon/drop_while_asking_test.go
new file mode 100644
index 00000000..c2f64e01
--- /dev/null
+++ b/daemon/drop_while_asking_test.go
@@ -0,0 +1,247 @@
+package main
+
+import (
+	"bytes"
+	"go/ast"
+	"go/parser"
+	"go/printer"
+	"go/token"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func resetBusyDrops() {
+	busyDrops.Store(0)
+	busyDropLoggedAt.Store(0)
+}
+
+func TestBusyDropCountsEveryDropAndRateLimitsItsLog(t *testing.T) {
+	resetBusyDrops()
+	defer resetBusyDrops()
+	// busyDropEpoch carries a monotonic reading, and Add keeps it.
+	t0 := busyDropEpoch
+
+	if n, logged := noteBusyDrop(t0); n != 1 || !logged {
+		t.Fatalf("first busy drop: n=%d logged=%v, want 1 true", n, logged)
+	}
+	if n, logged := noteBusyDrop(t0.Add(busyDropLogInterval / 2)); n != 2 || logged {
+		t.Fatalf("drop inside the log interval: n=%d logged=%v, want 2 false", n, logged)
+	}
+	if n, logged := noteBusyDrop(t0.Add(busyDropLogInterval)); n != 3 || !logged {
+		t.Fatalf("drop after the log interval: n=%d logged=%v, want 3 true", n, logged)
+	}
+}
+
+func TestConcurrentBusyDropsLogOnce(t *testing.T) {
+	resetBusyDrops()
+	defer resetBusyDrops()
+	now := busyDropEpoch.Add(time.Hour)
+	var logs int32
+	var wg sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if _, logged := noteBusyDrop(now); logged {
+				atomic.AddInt32(&logs, 1)
+			}
+		}()
+	}
+	wg.Wait()
+	if logs != 1 || busyDrops.Load() != 32 {
+		t.Fatalf("32 concurrent drops: %d log lines, counter %d; want 1, 32", logs, busyDrops.Load())
+	}
+}
+
+// funcBody returns the body of function name in main.go.
+func funcBody(t *testing.T, fset *token.FileSet, name string) *ast.BlockStmt {
+	t.Helper()
+	file, err := parser.ParseFile(fset, "main.go", nil, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, decl := range file.Decls {
+		if f, ok := decl.(*ast.FuncDecl); ok && f.Name.Name == name {
+			return f.Body
+		}
+	}
+	t.Fatalf("%s not found in main.go", name)
+	return nil
+}
+
+func render(t *testing.T, fset *token.FileSet, n ast.Node) string {
+	t.Helper()
+	var b bytes.Buffer
+	if err := printer.Fprint(&b, fset, n); err != nil {
+		t.Fatal(err)
+	}
+	return b.String()
+}
+
+// ifWithCond finds the if statement in body whose condition renders as cond.
+func ifWithCond(t *testing.T, fset *token.FileSet, body ast.Node, cond string) *ast.IfStmt {
+	t.Helper()
+	var found *ast.IfStmt
+	ast.Inspect(body, func(n ast.Node) bool {
+		if s, ok := n.(*ast.IfStmt); ok && found == nil && render(t, fset, s.Cond) == cond {
+			found = s
+		}
+		return found == nil
+	})
+	if found == nil {
+		t.Fatalf("no `if %s` found", cond)
+	}
+	return found
+}
+
+// The prompt slot is only claimed while the UI is connected, and only a
+// connection that lost the race for a held slot is dropped while busy. The UI
+// being away, or the option being off, keeps upstream's DefaultAction.
+func TestBusySlotDropsOnlyWhenOptedInAndConnected(t *testing.T) {
+	fset := token.NewFileSet()
+	body := funcBody(t, fset, "acceptOrDeny")
+	unasked := ifWithCond(t, fset, body, "!connected || !uiClient.TryStartAsking()")
+	busy := ifWithCond(t, fset, unasked.Body, "connected && uiClient.DropWhileAsking()")
+
+	busySrc := render(t, fset, busy.Body)
+	for _, want := range []string{"packet.SetVerdict(netfilter.NF_DROP)", "noteBusyDrop(", `return nil, "", true`} {
+		if !strings.Contains(busySrc, want) {
+			t.Fatalf("busy-drop branch lacks %q:\n%s", want, busySrc)
+		}
+	}
+	for _, banned := range []string{"applyDefaultAction", "rules.Add", "KillSocket", "SetIsAsking", "requeued packet not received"} {
+		if strings.Contains(busySrc, banned) {
+			t.Fatalf("busy-drop branch must not use %q:\n%s", banned, busySrc)
+		}
+	}
+
+	// After the busy branch, the unasked path still applies DefaultAction and
+	// reports it, so the connection is recorded as default-applied.
+	rest := render(t, fset, unasked.Body)
+	if !strings.Contains(rest, "action := applyDefaultAction(packet, con)") || !strings.Contains(rest, "return nil, action, false") {
+		t.Fatalf("unasked path no longer applies and reports DefaultAction:\n%s", rest)
+	}
+	if n := len(callArgs(t, "acceptOrDeny", "uiClient", "DropWhileAsking")); n != 1 {
+		t.Fatalf("acceptOrDeny reads DropWhileAsking %d times, want once (only for the busy slot)", n)
+	}
+}
+
+// A failed repeat-queue hand-off keeps its own log line and fail-open verdict;
+// it is neither a busy drop nor a default-applied event.
+func TestRequeueFailureIsNotABusyDropOrDefaultEvent(t *testing.T) {
+	fset := token.NewFileSet()
+	body := funcBody(t, fset, "acceptOrDeny")
+	fail := ifWithCond(t, fset, body, "err != nil")
+	src := render(t, fset, fail.Body)
+	if !strings.Contains(src, `log.Error("requeued packet not received, so it passes without being asked about (fail-open): %v", err)`) {
+		t.Fatalf("requeue failure log line changed:\n%s", src)
+	}
+	if !strings.Contains(src, `return nil, "", false`) || strings.Contains(src, "noteBusyDrop") || strings.Contains(src, "applyDefaultAction") {
+		t.Fatalf("requeue failure must return no rule and no default action:\n%s", src)
+	}
+}
+
+// endsInReturn reports whether block's last statement is a return.
+func endsInReturn(block *ast.BlockStmt) bool {
+	if len(block.List) == 0 {
+		return false
+	}
+	_, ok := block.List[len(block.List)-1].(*ast.ReturnStmt)
+	return ok
+}
+
+// stmtIndex returns the index of the top-level statement of body that
+// contains n.
+func stmtIndex(body *ast.BlockStmt, n ast.Node) int {
+	for i, s := range body.List {
+		if s.Pos() <= n.Pos() && n.End() <= s.End() {
+			return i
+		}
+	}
+	return -1
+}
+
+func TestOnPacketRecordsDefaultAppliedConnections(t *testing.T) {
+	fset := token.NewFileSet()
+	body := funcBody(t, fset, "onPacket")
+	rec := ifWithCond(t, fset, body, `defaultAction != ""`)
+	src := render(t, fset, rec.Body)
+	if !strings.Contains(src, "stats.OnDefaultActionEvent(con, defaultAction)") || !endsInReturn(rec.Body) {
+		t.Fatalf("default-applied connections are not recorded once, as default events:\n%s", src)
+	}
+	if n := len(callArgs(t, "onPacket", "stats", "OnConnectionEvent")); n != 1 {
+		t.Fatalf("onPacket calls OnConnectionEvent %d times, want 1", n)
+	}
+}
+
+// A busy drop is counted only in busyDrops: onPacket returns before any
+// statistics call, so no counter, map, Event or logger line changes.
+func TestBusyDropSkipsStatisticsEntirely(t *testing.T) {
+	fset := token.NewFileSet()
+	body := funcBody(t, fset, "onPacket")
+	skip := ifWithCond(t, fset, body, "busyDropped")
+	if len(skip.Body.List) != 1 || !endsInReturn(skip.Body) {
+		t.Fatalf("busy drops must return at once:\n%s", render(t, fset, skip.Body))
+	}
+	at := stmtIndex(body, skip)
+	ast.Inspect(body, func(n ast.Node) bool {
+		if sel, ok := n.(*ast.SelectorExpr); ok {
+			recordsConnection := sel.Sel.Name == "OnConnectionEvent" || sel.Sel.Name == "OnDefaultActionEvent"
+			if x, ok := sel.X.(*ast.Ident); ok && x.Name == "stats" && recordsConnection && stmtIndex(body, sel) <= at {
+				t.Fatalf("stats.%s runs before busy drops return", sel.Sel.Name)
+			}
+		}
+		return true
+	})
+
+	// Only the busy branch of acceptOrDeny reports a busy drop.
+	var busy []string
+	ast.Inspect(funcBody(t, fset, "acceptOrDeny"), func(n ast.Node) bool {
+		if ret, ok := n.(*ast.ReturnStmt); ok && len(ret.Results) == 3 {
+			if last := render(t, fset, ret.Results[2]); last != "false" {
+				busy = append(busy, render(t, fset, ret))
+			}
+		}
+		return true
+	})
+	if len(busy) != 1 || busy[0] != `return nil, "", true` {
+		t.Fatalf("acceptOrDeny reports a busy drop from %q, want only the busy branch", busy)
+	}
+}
+
+// A rule request that fails gets DefaultAction, and that is reported so the
+// connection is recorded as default-applied.
+func TestFailedAskReportsDefaultAction(t *testing.T) {
+	fset := token.NewFileSet()
+	body := funcBody(t, fset, "acceptOrDeny")
+	var failed string
+	ast.Inspect(body, func(n ast.Node) bool {
+		if s, ok := n.(*ast.IfStmt); ok && render(t, fset, s.Cond) == "r == nil" {
+			if src := render(t, fset, s.Body); strings.Contains(src, "Invalid rule received") && !strings.Contains(src, "TryStartAsking") {
+				failed = src
+			}
+		}
+		return true
+	})
+	if !strings.Contains(failed, "return nil, applyDefaultAction(packet, con), false") {
+		t.Fatalf("failed Ask does not report DefaultAction:\n%s", failed)
+	}
+}
+
+// Any DefaultAction other than allow or reject drops, including an empty one
+// (the bridge's Subscribe config may omit it); it is reported as deny, never
+// "", so the dropped connection is still recorded as default-applied.
+func TestDefaultActionReportsTheVerdictItGave(t *testing.T) {
+	fset := token.NewFileSet()
+	body := funcBody(t, fset, "applyDefaultAction")
+	guard := ifWithCond(t, fset, body, "action == rule.Reject")
+	if src := render(t, fset, guard.Body); src != "{\n\treturn rule.Reject\n}" {
+		t.Fatalf("reject is not reported as reject:\n%s", src)
+	}
+	if last := render(t, fset, body.List[len(body.List)-1]); last != "return rule.Deny" {
+		t.Fatalf("an unknown or empty DefaultAction is not reported as deny: %s", last)
+	}
+}
diff --git a/daemon/firewall/nftables/policy_journal.go b/daemon/firewall/nftables/policy_journal.go
new file mode 100644
index 00000000..c91bd683
--- /dev/null
+++ b/daemon/firewall/nftables/policy_journal.go
@@ -0,0 +1,127 @@
+package nftables
+
+import (
+	"reflect"
+	"sync"
+
+	"github.com/google/nftables"
+)
+
+type policyKey struct {
+	name, table string
+	family      nftables.TableFamily
+}
+
+func policyKeyFor(c *nftables.Chain) policyKey {
+	return policyKey{c.Name, c.Table.Name, c.Table.Family}
+}
+
+type policyChange struct{ before, applied *nftables.Chain }
+type policyJournal struct {
+	sync.Mutex
+	pending map[policyKey]policyChange
+	applied map[policyKey]policyChange
+}
+
+func copyChain(c *nftables.Chain) *nftables.Chain {
+	clone := *c
+	if c.Table != nil {
+		table := *c.Table
+		clone.Table = &table
+	}
+	if c.Policy != nil {
+		policy := *c.Policy
+		clone.Policy = &policy
+	}
+	if c.Hooknum != nil {
+		hook := *c.Hooknum
+		clone.Hooknum = &hook
+	}
+	if c.Priority != nil {
+		priority := *c.Priority
+		clone.Priority = &priority
+	}
+	return &clone
+}
+
+// Called under the journal lock, together with queueing the netlink update.
+func (j *policyJournal) queued(before, after *nftables.Chain) {
+	if before.Policy == nil || after.Policy == nil {
+		return
+	}
+	key := policyKeyFor(before)
+	previous, pending := j.pending[key]
+	change := policyChange{copyChain(before), copyChain(after)}
+	if pending {
+		// Even a no-op against the current kernel snapshot is an actual later
+		// netlink update: record the final queued value of this batch.
+		change.before = previous.before
+	} else if previous, owned := j.applied[key]; owned {
+		if reflect.DeepEqual(before, previous.applied) {
+			change.before = previous.before
+		} else {
+			// An administrator changed this definition/policy since our last update.
+			// Any new policy change now owns that new baseline, never the stale one.
+			delete(j.applied, key)
+		}
+	}
+	if !pending && *before.Policy == *after.Policy {
+		return
+	}
+	if j.pending == nil {
+		j.pending = make(map[policyKey]policyChange)
+	}
+	j.pending[key] = change
+}
+
+// A failed netlink batch never gives us ownership of the proposed policy.
+func (j *policyJournal) committed(success bool) {
+	if success {
+		if j.applied == nil {
+			j.applied = make(map[policyKey]policyChange)
+		}
+		for key, change := range j.pending {
+			j.applied[key] = change
+		}
+	}
+	j.pending = nil
+}
+
+// Caller holds the journal lock. The supplied operations are the real nftables
+// connection in production; tests can reject any write to a protected chain.
+func (j *policyJournal) restore(list func() ([]*nftables.Chain, error), add func(*nftables.Chain), flush func() error) error {
+	if len(j.applied) == 0 {
+		return nil
+	}
+	chains, err := list()
+	if err != nil {
+		return err
+	}
+	current := make(map[policyKey]*nftables.Chain)
+	for _, c := range chains {
+		current[policyKeyFor(c)] = c
+	}
+	queued := false
+	for key, change := range j.applied {
+		c := current[key]
+		// Missing chains and administrator policy/definition edits are not ours to
+		// recreate or overwrite. Compare a full value snapshot, not shared pointers.
+		if c == nil || !reflect.DeepEqual(c, change.applied) {
+			continue
+		}
+		restored := copyChain(c)
+		restored.Policy = copyChain(change.before).Policy
+		if reflect.DeepEqual(c.Policy, restored.Policy) {
+			continue
+		}
+		add(restored)
+		queued = true
+	}
+	if queued {
+		if err := flush(); err != nil {
+			return err
+		}
+	}
+	j.applied = nil
+	return nil
+}
