+// dispatchPackets hands queued packets to the workers until the daemon stops
+// or the queue closes; the returned channel is closed when it has returned.
+// A packet still held when the daemon stops is released by StopAndJoin.
+func dispatchPackets(done <-chan struct{}, packets <-chan netfilter.Packet, workers chan<- netfilter.Packet) <-chan struct{} {
+	finished := make(chan struct{})
+	go func() {
+		defer close(finished)
+		for {
+			select {
+			case <-done:
+				return
+			case pkt, ok := <-packets:
+				if !ok {
+					return
+				}
+				select {
+				case workers <- pkt:
+				case <-done:
+					return
+				}
+			}
+		}
+	}()
+	return finished
