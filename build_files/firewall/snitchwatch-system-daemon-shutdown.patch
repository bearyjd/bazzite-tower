+package netfilter
+
+import (
+	"errors"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+func TestRunContinuesPastFailedNetlinkMessage(t *testing.T) {
+	binary := filepath.Join(t.TempDir(), "queue-run-test")
+	args := []string{"-O2", "-Wall", "-Wextra", "-Werror", "-I.", "testdata/queue_run.c", "-lnetfilter_queue", "-lnfnetlink", "-ldl", "-pthread", "-Wl,--wrap=nfq_handle_packet", "-o", binary}
+	if out, err := exec.Command("cc", args...).CombinedOutput(); err != nil {
+		t.Fatalf("C Run test build: %v\n%s", err, out)
+	}
+	if out, err := exec.Command(binary).CombinedOutput(); err != nil {
+		t.Fatalf("C Run test: %v\n%s", err, out)
+	}
+}
+
+func TestReaderExitWithoutStopIsReported(t *testing.T) {
+	l := newQueueLifetime()
+	l.run(func() { l.readerExited(errors.New("errno=5")) })
+	select {
+	case <-l.failed:
+	case <-time.After(time.Second):
+		t.Fatal("reader exit without a stop request was not reported")
+	}
+	waitShutdown(t, l.done)
+	if l.err == nil || l.err.Error() != "errno=5" {
+		t.Fatalf("reader error not preserved: %v", l.err)
+	}
+}
+
+func TestRequestedStopIsNotReaderFailure(t *testing.T) {
+	l := newQueueLifetime()
+	release := make(chan struct{})
+	l.run(func() { <-release; l.readerExited(errors.New("woken")) })
+	l.stopAndJoin(func() { close(release) })
+	select {
+	case <-l.failed:
+		t.Fatal("requested stop reported as a reader failure")
+	default:
+	}
+}
+
+func TestQueueReaderDeathIsReported(t *testing.T) {
+	traffic, wake := []int{-1, -1}, []int{-1, -1}
+	if err := unix.Pipe2(traffic, unix.O_CLOEXEC); err != nil {
+		t.Fatal(err)
+	}
+	if err := unix.Pipe2(wake, unix.O_CLOEXEC|unix.O_NONBLOCK); err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(traffic[0])
+	q := &Queue{packets: make(chan Packet), lifetime: newQueueLifetime(), fd: traffic[0], wakeRead: wake[0], wakeWrite: wake[1]}
+	q.lifetime.run(q.run)
+	// A hung-up descriptor makes the real C reader return EIO with no stop request.
+	unix.Close(traffic[1])
+	select {
+	case <-q.ReaderFailed():
+	case <-time.After(time.Second):
+		t.Fatal("real C reader death was not reported")
+	}
+	if err := q.ReaderErr(); err == nil || !strings.Contains(err.Error(), "errno=5") {
+		t.Fatalf("unexpected reader error: %v", err)
+	}
+	q.Close()
+}
+
+func TestNilQueueReaderNeverFails(t *testing.T) {
+	var q *Queue
+	select {
+	case <-q.ReaderFailed():
+		t.Fatal("absent queue reported a reader failure")
+	default:
+	}
+	if err := q.ReaderErr(); err != nil {
+		t.Fatalf("absent queue error: %v", err)
+	}
+}
diff --git a/daemon/netfilter/queue_shutdown_test.go b/daemon/netfilter/queue_shutdown_test.go
new file mode 100644
index 00000000..da803221
--- /dev/null
+++ b/daemon/netfilter/queue_shutdown_test.go
@@ -0,0 +1,297 @@
+package netfilter
+
+import (
+	"golang.org/x/sys/unix"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func waitShutdown(t *testing.T, done <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("shutdown blocked")
+	}
+}
+
+func TestQueueLifetimeJoinsBeforeSingleRelease(t *testing.T) {
+	l := newQueueLifetime()
+	entered, leave := make(chan struct{}), make(chan struct{})
+	var released, wakes int32
+	l.run(func() { close(entered); <-l.stop; <-leave })
+	<-entered
+	done := make(chan struct{})
+	go func() {
+		l.close(func() { atomic.AddInt32(&wakes, 1) }, func() { atomic.AddInt32(&released, 1) })
+		close(done)
+	}()
+	<-l.stop
+	if atomic.LoadInt32(&released) != 0 {
+		t.Fatal("freed before reader/callback join")
+	}
+	close(leave)
+	waitShutdown(t, done)
+	var callers sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		callers.Add(1)
+		go func() {
+			defer callers.Done()
+			l.close(func() { atomic.AddInt32(&wakes, 1) }, func() { atomic.AddInt32(&released, 1) })
+		}()
+	}
+	callers.Wait()
+	if released != 1 || wakes != 1 {
+		t.Fatalf("release=%d wake=%d", released, wakes)
+	}
+}
+
+func TestQueueCloseWakesRealCPollIndependently(t *testing.T) {
+	makeQueue := func() (*Queue, []int) {
+		traffic, wake := []int{-1, -1}, []int{-1, -1}
+		if err := unix.Pipe2(traffic, unix.O_CLOEXEC); err != nil {
+			t.Fatal(err)
+		}
+		if err := unix.Pipe2(wake, unix.O_CLOEXEC|unix.O_NONBLOCK); err != nil {
+			t.Fatal(err)
+		}
+		q := &Queue{packets: make(chan Packet), lifetime: newQueueLifetime(), fd: 0, wakeRead: wake[0], wakeWrite: wake[1]}
+		q.fd = traffic[0]
+		q.lifetime.run(q.run)
+		return q, traffic
+	}
+	first, a := makeQueue()
+	second, b := makeQueue()
+	defer unix.Close(a[0])
+	defer unix.Close(a[1])
+	defer unix.Close(b[0])
+	defer unix.Close(b[1])
+	done := make(chan struct{})
+	go func() { first.Close(); close(done) }()
+	waitShutdown(t, done)
+	select {
+	case <-second.lifetime.done:
+		t.Fatal("closing one queue stopped another")
+	default:
+	}
+	done = make(chan struct{})
+	go func() { second.Close(); close(done) }()
+	waitShutdown(t, done)
+	if _, open := <-first.Packets(); open {
+		t.Fatal("packet channel not closed")
+	}
+	first.Close()
+	second.Close()
+}
+
+func TestQueuePartialInitializationCleanup(t *testing.T) {
+	wake := []int{-1, -1}
+	if err := unix.Pipe2(wake, unix.O_CLOEXEC|unix.O_NONBLOCK); err != nil {
+		t.Fatal(err)
+	}
+	q := &Queue{packets: make(chan Packet), lifetime: newQueueLifetime(), wakeRead: wake[0], wakeWrite: wake[1]}
+	close(q.lifetime.done) // constructor failure, no reader started
+	q.Close()
+	q.Close()
+	for _, fd := range wake {
+		if _, err := unix.Write(fd, []byte{1}); err != unix.EBADF {
+			t.Fatalf("partial fd not closed: %v", err)
+		}
+	}
+}
+
+func TestCallbackCancellationReleasesLateWorker(t *testing.T) {
+	q := &Queue{packets: make(chan Packet), lifetime: newQueueLifetime()}
+	p := Packet{verdictChannel: make(chan VerdictContainer, 1), verdictOnce: new(sync.Once), queueDone: q.lifetime.stop}
+	result := make(chan VerdictContainer, 1)
+	go func() { result <- q.deliverPacket(p) }()
+	var worker Packet
+	select {
+	case worker = <-q.packets:
+	case <-time.After(time.Second):
+		t.Fatal("callback did not reach worker")
+	}
+	close(q.lifetime.stop)
+	select {
+	case got := <-result:
+		if got.Verdict != NF_ACCEPT {
+			t.Fatal("shutdown changed fallback")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("callback waited for verdict after cancellation")
+	}
+	done := make(chan struct{})
+	go func() { worker.SetVerdict(NF_DROP); worker.SetVerdict(NF_ACCEPT); close(done) }()
+	waitShutdown(t, done)
+}
+
+func TestVerdictDeliveryIsSingleShotAndCancellationSafe(t *testing.T) {
+	for i := 0; i < 100; i++ {
+		stop := make(chan struct{})
+		p := Packet{verdictChannel: make(chan VerdictContainer, 1), verdictOnce: new(sync.Once), queueDone: stop}
+		var workers sync.WaitGroup
+		for j := 0; j < 16; j++ {
+			workers.Add(1)
+			go func() { defer workers.Done(); p.SetVerdictAndMark(NF_DROP, 42) }()
+		}
+		workers.Wait()
+		if got := <-p.verdictChannel; got.Verdict != NF_DROP || got.Mark != 42 {
+			t.Fatal("wrong winning verdict")
+		}
+		select {
+		case <-p.verdictChannel:
+			t.Fatal("duplicate verdict")
+		default:
+		}
+		close(stop)
+		p.SetVerdictWithPacket(NF_ACCEPT, []byte{1})
+	}
+}
+
+func TestCallbackAlreadyCanceledDoesNotAdmitPacket(t *testing.T) {
+	q := &Queue{packets: make(chan Packet, 1), lifetime: newQueueLifetime()}
+	close(q.lifetime.stop)
+	if q.deliverPacket(Packet{}).Verdict != NF_ACCEPT {
+		t.Fatal("wrong fallback")
+	}
+	if len(q.packets) != 0 {
+		t.Fatal("packet admitted after stop")
+	}
+}
+
+func TestCallbackVerdictCancellationRaceNeverBlocksWorker(t *testing.T) {
+	for i := 0; i < 100; i++ {
+		q := &Queue{packets: make(chan Packet), lifetime: newQueueLifetime()}
+		p := Packet{verdictChannel: make(chan VerdictContainer, 1), verdictOnce: new(sync.Once), queueDone: q.lifetime.stop}
+		result := make(chan VerdictContainer, 1)
+		go func() { result <- q.deliverPacket(p) }()
+		var worker Packet
+		select {
+		case worker = <-q.packets:
+		case <-time.After(time.Second):
+			t.Fatal("packet not admitted")
+		}
+		gate, done := make(chan struct{}), make(chan struct{})
+		go func() { <-gate; worker.SetVerdict(NF_DROP); worker.SetVerdict(NF_ACCEPT); close(done) }()
+		close(gate)
+		close(q.lifetime.stop)
+		waitShutdown(t, done)
+		select {
+		case verdict := <-result:
+			if verdict.Verdict != NF_DROP && verdict.Verdict != NF_ACCEPT {
+				t.Fatal("invalid race result")
+			}
+		case <-time.After(time.Second):
+			t.Fatal("callback blocked in race")
+		}
+	}
+}
+
+func TestNewQueuePermissionFailureClosesPartialHandles(t *testing.T) {
+	header := unix.CapUserHeader{Version: unix.LINUX_CAPABILITY_VERSION_3}
+	capabilities := [2]unix.CapUserData{}
+	if err := unix.Capget(&header, &capabilities[0]); err != nil {
+		t.Fatal(err)
+	}
+	if capabilities[0].Effective&(1<<unix.CAP_NET_ADMIN) != 0 {
+		t.Skip("failure test must not have network administration privileges")
+	}
+	descriptors := func() int {
+		fds, err := os.ReadDir("/proc/self/fd")
+		if err != nil {
+			t.Fatal(err)
+		}
+		return len(fds)
+	}
+	// Warm Go runtime/netlink descriptors before measuring the rejected handles.
+	if q, err := NewQueue(65500); err == nil {
+		q.Close()
+		t.Fatal("unprivileged queue unexpectedly succeeded")
+	}
+	before := descriptors()
+	for i := 0; i < 16; i++ {
+		if q, err := NewQueue(65500); err == nil {
+			q.Close()
+			t.Fatal("unprivileged queue unexpectedly succeeded")
+		}
+	}
+	if after := descriptors(); after != before {
+		t.Fatalf("failed creation leaked descriptors: before%d after%d", before, after)
+	}
+}
+
+func TestStopAndJoinPreservesQueueOwnershipUntilClose(t *testing.T) {
+	traffic, wake := []int{-1, -1}, []int{-1, -1}
+	if err := unix.Pipe2(traffic, unix.O_CLOEXEC); err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(traffic[0])
+	defer unix.Close(traffic[1])
+	if err := unix.Pipe2(wake, unix.O_CLOEXEC|unix.O_NONBLOCK); err != nil {
+		t.Fatal(err)
+	}
+	q := &Queue{idx: atomic.AddUint32(&nextQueueIndex, 1), packets: make(chan Packet), lifetime: newQueueLifetime(), fd: traffic[0], wakeRead: wake[0], wakeWrite: wake[1]}
+	queueIndexLock.Lock()
+	queueIndex[q.idx] = q
+	queueIndexLock.Unlock()
+	q.lifetime.run(q.run)
+	defer q.Close()
+	q.StopAndJoin()
+	select {
+	case <-q.lifetime.done:
+	default:
+		t.Fatal("StopAndJoin returned before reader finished")
+	}
+	queueIndexLock.RLock()
+	owned := queueIndex[q.idx] == q
+	queueIndexLock.RUnlock()
+	if !owned {
+		t.Fatal("queue index removed before config query")
+	}
+	for _, fd := range wake {
+		if _, err := unix.FcntlInt(uintptr(fd), unix.F_GETFD, 0); err != nil {
+			t.Fatal("owned wake descriptor freed before Close", err)
+		}
+	}
+	select {
+	case <-q.packets:
+		t.Fatal("packet channel closed before Close")
+	default:
+	}
+	var callers sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		callers.Add(1)
+		go func() { defer callers.Done(); q.StopAndJoin(); q.Close() }()
+	}
+	callers.Wait()
+	queueIndexLock.RLock()
+	_, owned = queueIndex[q.idx]
+	queueIndexLock.RUnlock()
+	if owned {
+		t.Fatal("queue index retained after Close")
+	}
+	for _, fd := range wake {
+		if _, err := unix.FcntlInt(uintptr(fd), unix.F_GETFD, 0); err != unix.EBADF {
+			t.Fatalf("descriptor not closed once: %v", err)
+		}
+	}
+}
+
+func TestRetiredCConfigCallbackDoesNotSendVerdict(t *testing.T) {
+	binary := filepath.Join(t.TempDir(), "queue-callback-test")
+	args := []string{"-O2", "-Wall", "-Wextra", "-Werror", "-I.", "testdata/queue_callback.c", "-lnetfilter_queue", "-lnfnetlink", "-ldl", "-pthread", "-o", binary}
+	for _, name := range []string{"nfq_get_msg_packet_hdr", "nfq_get_payload", "nfq_get_indev", "nfq_get_outdev", "nfq_get_nfmark", "nfq_set_verdict2"} {
+		args = append(args, "-Wl,--wrap="+name)
+	}
+	if out, err := exec.Command("cc", args...).CombinedOutput(); err != nil {
+		t.Fatalf("Ccallback test build: %v\n%s", err, out)
+	}
+	if out, err := exec.Command(binary).CombinedOutput(); err != nil {
+		t.Fatalf("Ccallback test: %v\n%s", err, out)
+	}
+}
diff --git a/daemon/netfilter/requeue.go b/daemon/netfilter/requeue.go
new file mode 100644
index 00000000..00fa0a9a
--- /dev/null
+++ b/daemon/netfilter/requeue.go
@@ -0,0 +1,42 @@
+package netfilter
+
+import (
+	"bytes"
+	"errors"
+	"time"
+
+	"github.com/evilsocket/opensnitch/daemon/log"
+)
+
+var (
+	// ErrRequeueTimeout means the requeued packet did not come back in time.
+	ErrRequeueTimeout = errors.New("timed out waiting for the requeued packet")
+	// ErrRequeueClosed means the repeat queue stopped.
+	ErrRequeueClosed = errors.New("repeat queue closed")
+)
+
+// ReceiveRequeued waits up to timeout for the requeued packet whose payload is
+// want. A different packet is a late hand-off from an earlier, abandoned ask;
+// it gets the fail-open verdict its callback would otherwise have timed out
+// to, so that callback is released, and the wait goes on.
+// Matching is by payload, so a byte-identical retransmit of the same flow
+// counts as ours, as upstream's comparison did.
+func ReceiveRequeued(packets <-chan Packet, want []byte, timeout time.Duration) (Packet, error) {
+	timer := time.NewTimer(timeout)
+	defer timer.Stop()
+	for {
+		select {
+		case pkt, ok := <-packets:
+			if !ok {
+				return Packet{}, ErrRequeueClosed
+			}
+			if bytes.Equal(pkt.Packet.Data(), want) {
+				return pkt, nil
+			}
+			log.Warning("accepting a stale requeued packet from an abandoned ask")
+			pkt.SetVerdict(NF_ACCEPT)
+		case <-timer.C:
+			return Packet{}, ErrRequeueTimeout
+		}
+	}
+}
diff --git a/daemon/netfilter/requeue_handoff_test.go b/daemon/netfilter/requeue_handoff_test.go
new file mode 100644
index 00000000..0a597355
--- /dev/null
+++ b/daemon/netfilter/requeue_handoff_test.go
@@ -0,0 +1,102 @@
+package netfilter
+
+import (
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/google/gopacket"
+	"github.com/google/gopacket/layers"
+)
+
+func handoffPacket(stop <-chan struct{}, payload ...byte) Packet {
+	return Packet{
+		Packet:         gopacket.NewPacket(payload, layers.LayerTypeIPv4, gopacket.Default),
+		verdictChannel: make(chan VerdictContainer, 1), verdictOnce: new(sync.Once), queueDone: stop,
+	}
+}
+
+func awaitVerdict(t *testing.T, result <-chan VerdictContainer, within time.Duration) VerdictContainer {
+	t.Helper()
+	select {
+	case v := <-result:
+		return v
+	case <-time.After(within):
+		t.Fatalf("callback did not return within %v", within)
+	}
+	return VerdictContainer{}
+}
+
+func TestRepeatQueueWaitsForLateAskingWorker(t *testing.T) {
+	q := &Queue{packets: make(chan Packet), lifetime: newQueueLifetime(), deliveryTimeout: time.Second}
+	result := make(chan VerdictContainer, 1)
+	go func() { result <- q.deliverPacket(handoffPacket(q.lifetime.stop, 0x45)) }()
+	// The asking worker parks 20 ms late, well past upstream's 1 ms budget.
+	time.Sleep(20 * time.Millisecond)
+	select {
+	case worker := <-q.packets:
+		worker.SetVerdict(NF_DROP)
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("callback gave up before the late worker arrived (packet accepted without asking)")
+	}
+	if got := awaitVerdict(t, result, 2*time.Second); got.Verdict != NF_DROP {
+		t.Fatalf("late worker's verdict lost: got %d, want NF_DROP", got.Verdict)
+	}
+}
+
+func TestPrimaryQueueKeepsUpstreamHandoffBudget(t *testing.T) {
+	if DefaultDeliveryTimeout != time.Millisecond {
+		t.Fatalf("primary hand-off budget changed: %v", DefaultDeliveryTimeout)
+	}
+	// Nobody receives: a zero deliveryTimeout must fall back to the 1 ms default,
+	// not wait, and fail open.
+	q := &Queue{packets: make(chan Packet), lifetime: newQueueLifetime()}
+	result := make(chan VerdictContainer, 1)
+	go func() { result <- q.deliverPacket(handoffPacket(q.lifetime.stop, 0x45)) }()
+	if got := awaitVerdict(t, result, 500*time.Millisecond); got.Verdict != NF_ACCEPT {
+		t.Fatalf("default queue should fail open, got %d", got.Verdict)
+	}
+}
+
+func TestReceiveRequeuedReleasesStalePacketsAndReturnsOurs(t *testing.T) {
+	stop := make(chan struct{})
+	packets := make(chan Packet)
+	stale, ours := handoffPacket(stop, 1, 2), handoffPacket(stop, 3, 4)
+	go func() { packets <- stale; time.Sleep(20 * time.Millisecond); packets <- ours }()
+	got, err := ReceiveRequeued(packets, []byte{3, 4}, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got.Packet.Data()) != string([]byte{3, 4}) {
+		t.Fatalf("returned the wrong packet: %v", got.Packet.Data())
+	}
+	select {
+	case v := <-stale.verdictChannel:
+		if v.Verdict != NF_ACCEPT {
+			t.Fatalf("stale packet verdict %d, want NF_ACCEPT", v.Verdict)
+		}
+	default:
+		t.Fatal("stale packet left without a verdict: its queue callback would block forever")
+	}
+	select {
+	case v := <-ours.verdictChannel:
+		t.Fatalf("our packet must be left for the asker, got verdict %d", v.Verdict)
+	default:
+	}
+}
+
+func TestReceiveRequeuedTimesOutAndReportsClose(t *testing.T) {
+	start := time.Now()
+	if _, err := ReceiveRequeued(make(chan Packet), []byte{1}, 30*time.Millisecond); !errors.Is(err, ErrRequeueTimeout) {
+		t.Fatalf("want ErrRequeueTimeout, got %v", err)
+	}
+	if time.Since(start) > time.Second {
+		t.Fatal("timeout not honoured")
+	}
+	closed := make(chan Packet)
+	close(closed)
+	if _, err := ReceiveRequeued(closed, []byte{1}, time.Second); !errors.Is(err, ErrRequeueClosed) {
+		t.Fatalf("want ErrRequeueClosed, got %v", err)
+	}
+}
