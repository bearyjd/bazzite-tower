+// Stop is called with the loader lock held, so it must not wait for the
+// monitor (which sleeps between polls) and must tolerate a second call.
+func TestStopMonitoringListsIsPromptAndIdempotent(t *testing.T) {
+	for _, confined := range []bool{false, true} {
+		t.Run(fmt.Sprint("confined=", confined), func(t *testing.T) {
+			dir := t.TempDir() + "/domains"
+			if confined {
+				dir = useSnitchwatchRoot(t) + "/ads/domains"
+			}
+			writeFile(t, dir+"/domains.list", "0.0.0.0 a.example\n")
+			o := &Operator{Type: Lists, Operand: OpDomainsLists, Data: dir}
+			if err := o.Compile(); err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { stopAndWait(t, o) })
+			for deadline := time.Now().Add(3 * time.Second); numLists(o) == 0; time.Sleep(10 * time.Millisecond) {
+				if time.Now().After(deadline) {
+					t.Fatal("monitor never loaded the list")
+				}
+			}
+			// The monitor is now sleeping until its next poll.
+			start := time.Now()
+			done := make(chan struct{})
+			go func() {
+				o.StopMonitoringLists()
+				o.StopMonitoringLists()
+				close(done)
+			}()
+			select {
+			case <-done:
+			case <-time.After(time.Second):
+				t.Fatal("StopMonitoringLists blocked")
+			}
+			for numLists(o) != 0 {
+				if time.Since(start) > time.Second {
+					t.Fatal("monitor did not exit promptly")
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+		})
+	}
+}
