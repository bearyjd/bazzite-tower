+#include "queue.h"
+#include <assert.h>
+
+static int retired, verdicts;
+static unsigned char payload[]={0x45,0};
+static struct nfqnl_msg_packet_hdr packet={.packet_id=0};
+struct nfqnl_msg_packet_hdr *__wrap_nfq_get_msg_packet_hdr(struct nfq_data *data) { (void)data; return &packet; }
+int __wrap_nfq_get_payload(struct nfq_data *data,unsigned char **out) { (void)data; *out=payload; return sizeof(payload); }
+uint32_t __wrap_nfq_get_indev(struct nfq_data *data) { (void)data; return 0; }
+uint32_t __wrap_nfq_get_outdev(struct nfq_data *data) { (void)data; return 0; }
+uint32_t __wrap_nfq_get_nfmark(struct nfq_data *data) { (void)data; return 0; }
+int __wrap_nfq_set_verdict2(struct nfq_q_handle *qh,uint32_t id,uint32_t verdict,uint32_t mark,uint32_t len,const unsigned char *data) {
+    (void)qh;(void)id;(void)mark;(void)len;(void)data;
+    assert(verdict==NF_ACCEPT);verdicts++;return 24;
+}
+void go_callback(int id,unsigned char *data,int len,unsigned int mark,uint32_t idx,verdictContainer *vc,uint32_t uid,uint32_t in_dev,uint32_t out_dev) {
+    (void)id;(void)data;(void)len;(void)mark;(void)idx;(void)uid;(void)in_dev;(void)out_dev;
+    vc->verdict=NF_ACCEPT;vc->skip_verdict=retired;
+}
+int main(void) {
+    assert(nf_callback(NULL,NULL,NULL,(void *)(uintptr_t)1)==24);
+    assert(verdicts==1);
+    retired=1;
+    // nfnl_query must continue past retired queued packet notifications to ACK.
+    for(int i=0;i<32;i++)assert(nf_callback(NULL,NULL,NULL,(void *)(uintptr_t)1)==NFNL_CB_CONTINUE);
+    assert(verdicts==1);
+    puts("active Ccallback verdict preserved; retired config callbacks continue without verdict");
+    return 0;
+}
diff --git a/daemon/netfilter/testdata/queue_run.c b/daemon/netfilter/testdata/queue_run.c
new file mode 100644
index 00000000..7621d2e5
--- /dev/null
+++ b/daemon/netfilter/testdata/queue_run.c
@@ -0,0 +1,46 @@
+#include "queue.h"
+#include <assert.h>
+#include <sys/socket.h>
+#include <time.h>
+
+// A queued packet message carries up to the 4096-byte copy range plus netlink
+// and nfqueue attribute headers, so it is larger than the copy range itself.
+#define QUEUED_MESSAGE_LEN (4096 + 400)
+
+static int handled, largest;
+int __wrap_nfq_handle_packet(struct nfq_handle *h,char *buf,int len) {
+    (void)h;(void)buf;
+    if (len > __atomic_load_n(&largest,__ATOMIC_SEQ_CST)) __atomic_store_n(&largest,len,__ATOMIC_SEQ_CST);
+    // libnetfilter_queue returns -1 for any NLMSG_ERROR, e.g. the kernel's
+    // reply to a verdict for an entry it already flushed when a base chain
+    // was unregistered. The first message models that stale error.
+    return __atomic_fetch_add(&handled,1,__ATOMIC_SEQ_CST)==0 ? -1 : 0;
+}
+void go_callback(int id,unsigned char *data,int len,unsigned int mark,uint32_t idx,verdictContainer *vc,uint32_t uid,uint32_t in_dev,uint32_t out_dev) {
+    (void)id;(void)data;(void)len;(void)mark;(void)idx;(void)vc;(void)uid;(void)in_dev;(void)out_dev;
+}
+static int traffic[2], wake[2], result=-1;
+static void *reader(void *arg) { (void)arg; result=Run(NULL,traffic[0],wake[0]); return NULL; }
+int main(void) {
+    static char large[QUEUED_MESSAGE_LEN];
+    pthread_t thread;
+    assert(socketpair(AF_UNIX,SOCK_DGRAM,0,traffic)==0);
+    assert(pipe(wake)==0);
+    assert(pthread_create(&thread,NULL,reader,NULL)==0);
+    assert(send(traffic[1],"stale",5,0)==5);
+    assert(send(traffic[1],"packet",6,0)==6);
+    assert(send(traffic[1],large,sizeof(large),0)==(ssize_t)sizeof(large));
+    // The reader must survive the failed message and handle the next ones.
+    for (int i=0;i<1000 && __atomic_load_n(&handled,__ATOMIC_SEQ_CST)<3;i++) {
+        struct timespec pause={0,5000000};
+        nanosleep(&pause,NULL);
+    }
+    assert(__atomic_load_n(&handled,__ATOMIC_SEQ_CST)==3);
+    // A truncated message cannot be parsed, so its packet would never get a verdict.
+    assert(__atomic_load_n(&largest,__ATOMIC_SEQ_CST)==QUEUED_MESSAGE_LEN);
+    assert(write(wake[1],"x",1)==1);
+    assert(pthread_join(thread,NULL)==0);
+    assert(result==0);
+    puts("reader kept the bound queue after a failed message and received a full-size queued message");
+    return 0;
+}
diff --git a/daemon/queue_cleanup_order_test.go b/daemon/queue_cleanup_order_test.go
new file mode 100644
index 00000000..96b27a7d
--- /dev/null
+++ b/daemon/queue_cleanup_order_test.go
@@ -0,0 +1,61 @@
+package main
+
+import (
+	"testing"
+	"time"
+)
+
+type heldShutdownQueue struct {
+	entered      chan struct{}
+	callbackDone chan struct{}
+	joined       chan struct{}
+}
+
+func (q *heldShutdownQueue) StopAndJoin() {
+	close(q.entered)
+	<-q.callbackDone
+	close(q.joined)
+}
+func TestCleanupKeepsFirewallUntilBothCallbacksJoined(t *testing.T) {
+	repeat := &heldShutdownQueue{make(chan struct{}), make(chan struct{}), make(chan struct{})}
+	primary := &heldShutdownQueue{make(chan struct{}), make(chan struct{}), make(chan struct{})}
+	firewallRemoved := make(chan struct{})
+	done := make(chan struct{})
+	go func() { quiesceQueuesBeforeFirewall(repeat, primary, func() { close(firewallRemoved) }); close(done) }()
+	<-repeat.entered
+	select {
+	case <-firewallRemoved:
+		t.Fatal("hooks removed while repeat callback held")
+	default:
+	}
+	close(repeat.callbackDone)
+	<-primary.entered
+	select {
+	case <-repeat.joined:
+	default:
+		t.Fatal("primary quiesced before repeat joined")
+	}
+	select {
+	case <-firewallRemoved:
+		t.Fatal("hooks removed while primary callback held")
+	default:
+	}
+	close(primary.callbackDone)
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("cleanup blocked")
+	}
+	select {
+	case <-primary.joined:
+	default:
+		t.Fatal("firewall removed before primary joined")
+	}
+	select {
+	case <-firewallRemoved:
+	default:
+		t.Fatal("firewall not removed after joins")
+	}
+}
+
+// No global services or kernel privileges are used.
diff --git a/daemon/reader_failure_test.go b/daemon/reader_failure_test.go
