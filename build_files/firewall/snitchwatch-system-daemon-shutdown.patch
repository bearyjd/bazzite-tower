+		}},
+		{name: "double slash", data: "ads//domains", setup: func(t *testing.T, blk, out string) {
+			writeFile(t, blk+"/ads/domains/domains.list", good)
+		}},
+		{name: "dotdot", data: "x/../ads/domains", setup: func(t *testing.T, blk, out string) {
+			writeFile(t, blk+"/ads/domains/domains.list", good)
+		}},
+		{name: "dotdot out of the tree", data: "../../x/domains", setup: func(t *testing.T, blk, out string) {
+			writeFile(t, blk+"/../../x/domains/domains.list", good)
+		}},
+		{name: "unclean path into the tree", abs: func(blk string) string {
+			root := filepath.Dir(blk)
+			return filepath.Dir(root) + "/./" + filepath.Base(root) + "/blocklists/ads/domains"
+		}, setup: func(t *testing.T, blk, out string) { writeFile(t, blk+"/ads/domains/domains.list", good) }},
+		{name: "unknown kind dir", data: "ads/other", setup: func(t *testing.T, blk, out string) {
+			writeFile(t, blk+"/ads/other/other.list", good)
+			writeFile(t, blk+"/ads/other/domains.list", good)
+		}},
+		{name: "kind/operand mismatch", operand: OpIPLists, setup: func(t *testing.T, blk, out string) {
+			writeFile(t, blk+"/ads/domains/domains.list", good)
+			writeFile(t, blk+"/ads/domains/ips.list", "10.0.0.1\n")
+		}},
+		{name: "exactly the byte cap", bytes: int64(len(two)),
+			setup: func(t *testing.T, blk, out string) { writeFile(t, blk+"/ads/domains/domains.list", two) },
+			want:  []string{"a.example", "b.example"}},
+		{name: "one byte over the cap", bytes: int64(len(two)) - 1,
+			setup: func(t *testing.T, blk, out string) { writeFile(t, blk+"/ads/domains/domains.list", two) }},
