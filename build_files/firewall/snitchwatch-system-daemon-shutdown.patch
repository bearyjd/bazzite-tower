+	useBudget(t, 1000)
+	confinedLoadRefused(path, 10, 5000, true)
+	if confinedLoadAllowed(path, 10) {
+		t.Error("unchanged file retried although its estimate does not fit")
+	}
+	if !confinedLoadAllowed(path, 20) {
+		t.Error("changed file not retried")
+	}
+}
diff --git a/daemon/rule/rule_name_test.go b/daemon/rule/rule_name_test.go
new file mode 100644
index 00000000..4310ab74
--- /dev/null
+++ b/daemon/rule/rule_name_test.go
@@ -0,0 +1,79 @@
+package rule
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// The daemon runs as root and builds rule file paths from rule names that
+// arrive from the UI channel, so a name must never leave the rules directory.
+func TestLoaderRefusesRuleNamesOutsideTheRulesDir(t *testing.T) {
+	base := t.TempDir()
+	rulesDir := filepath.Join(base, "rules")
+	if err := os.Mkdir(rulesDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	victim := filepath.Join(base, "default-config.json")
+	if err := os.WriteFile(victim, []byte("{}\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	l, err := NewLoader(false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := l.Load(rulesDir); err != nil {
+		t.Fatal(err)
+	}
+	op, _ := NewOperator(Simple, false, OpTrue, "", nil)
+	op.Compile()
+	bad := []string{"../default-config", "../../tmp/x", "a/b", `a\b`, "..", ".", "", "x\nforged log line", "x\x00y",
+		strings.Repeat("a", 201), strings.Repeat("é", 101), "spoof\u202egnp", "zero\u200bwidth", "line\u2028sep", "x\xffy"}
+	for _, name := range bad {
+		if err := l.Add(Create(name, "", true, false, false, Deny, Always, op), true); err == nil {
+			t.Errorf("Add accepted rule name %q", name)
+		}
+		if err := l.Replace(Create(name, "", true, false, false, Deny, Always, op), true); err == nil {
+			t.Errorf("Replace accepted rule name %q", name)
+		}
+		if l.GetAll()[name] != nil {
+			t.Errorf("rule name %q reached the in-memory rule set", name)
+		}
+	}
+	// A rule already in memory under a bad name (e.g. loaded before this
+	// check existed) must not steer a delete outside the rules directory.
+	l.Lock()
+	l.rules["../default-config"] = Create("../default-config", "", true, false, false, Deny, Always, op)
+	l.Unlock()
+	if err := l.Delete("../default-config"); err == nil {
+		t.Error("Delete accepted a traversal rule name")
+	}
+	if _, err := os.Stat(victim); err != nil {
+		t.Fatalf("file outside the rules directory was touched: %v", err)
+	}
+	if entries, _ := os.ReadDir(base); len(entries) != 2 {
+		t.Fatalf("files created outside the rules directory: %v", entries)
+	}
+	// A rule loaded from disk carries the name from the file's contents, not
+	// its file name; turning it temporary must not delete outside the dir.
+	l.Lock()
+	l.rules["../default-config"] = Create("../default-config", "", true, false, false, Deny, Always, op)
+	l.Unlock()
+	l.deleteOldRuleFromDisk(l.GetAll()["../default-config"], Create("../default-config", "", true, false, false, Deny, Restart, op))
+	if _, err := os.Stat(victim); err != nil {
+		t.Fatalf("a disk-loaded rule name deleted a file outside the rules directory: %v", err)
+	}
+	for _, name := range []string{strings.Repeat("a", 200), strings.Repeat("é", 100), "größe-über-straße"} {
+		if err := ValidName(name); err != nil {
+			t.Errorf("valid name %q refused: %v", name, err)
+		}
+	}
+	good := "snitchwatch-allow-10.0.2.2-f9292b96ff7d66ab-49190-pcurl-f0da955d46aa49e3"
+	if err := l.Add(Create(good, "", true, false, false, Allow, Always, op), true); err != nil {
+		t.Fatalf("valid rule name refused: %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(rulesDir, good+".json")); err != nil {
+		t.Fatalf("valid rule not saved: %v", err)
+	}
+}
diff --git a/daemon/rule/ui_blocklist.go b/daemon/rule/ui_blocklist.go
new file mode 100644
index 00000000..4456f295
--- /dev/null
+++ b/daemon/rule/ui_blocklist.go
@@ -0,0 +1,80 @@
+package rule
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+
+	"github.com/evilsocket/opensnitch/daemon/ui/protocol"
+)
+
+// BlocklistsRoot is the directory the Snitchwatch bridge owns for blocklist
+// rules. It is a var only so tests can point it at a temp dir; it must stay
+// absolute, clean and free of glob metacharacters.
+var BlocklistsRoot = "/var/lib/snitchwatch/blocklists"
+
+// blocklistName is the only rule name a UI lists rule may carry:
+// z00-blocklist:<list>:<kind>.
+var blocklistName = regexp.MustCompile(`^z00-blocklist:([A-Za-z0-9_-]{1,81}|[A-Za-z0-9_-]{1,40}\.[0-9a-f]{16}):(domains|ips)$`)
+
+var blocklistKinds = map[string]Operand{"domains": OpDomainsLists, "ips": OpIPLists}
+
+// validateUIRule checks a rule received over the UI channel. A lists operator
+// is accepted only as a top-level Snitchwatch blocklist deny rule whose data
+// is rebuilt from its (regex-checked) name, so the client can never choose
+// which directory the root daemon reads; every other shape goes through
+// validateUIOperator, which still refuses lists anywhere else. Only the
+// CHANGE_RULE path passes allowBlocklist.
+func validateUIRule(reply *protocol.Rule, allowBlocklist bool) error {
+	op := reply.Operator
+	if op == nil {
+		return fmt.Errorf("missing operator")
+	}
+	if !allowBlocklist || Type(op.Type) != Lists && !strings.HasPrefix(op.Operand, "lists.") {
+		return validateUIOperator(op, 0)
+	}
+	m := blocklistName.FindStringSubmatch(reply.Name)
+	if m == nil {
+		return fmt.Errorf("lists operator refused for rule name %q", reply.Name)
+	}
+	list, kind := m[1], m[2]
+	switch {
+	case Type(op.Type) != Lists || Operand(op.Operand) != blocklistKinds[kind]:
+		return fmt.Errorf("blocklist %s rule needs type lists and operand %s", kind, blocklistKinds[kind])
+	case op.Sensitive || len(op.List) != 0:
+		return fmt.Errorf("blocklist rule operator must be plain")
+	case op.Data != BlocklistsRoot+"/"+list+"/"+kind:
+		return fmt.Errorf("blocklist rule data %q does not match its name", op.Data)
+	case Action(reply.Action) != Deny || Duration(reply.Duration) != Always || reply.Precedence:
+		return fmt.Errorf("blocklist rule must be deny/always without precedence")
+	}
+	return nil
+}
+
+// maxBlocklistRules bounds the bridge's blocklist rules (32 subscriptions x 2
+// kinds); each one is a lists monitor and up to maxBlocklistFileBytes of list.
+const maxBlocklistRules = 64
+
+const blocklistRulePrefix = "z00-blocklist:"
+
+// checkBlocklistCap refuses a new blocklist rule once maxBlocklistRules are
+// loaded; replacing a loaded one by name is fine. The caller holds the
+// loader's write lock and inserts in the same critical section.
+func (l *Loader) checkBlocklistCap(name string) error {
+	if !strings.HasPrefix(name, blocklistRulePrefix) {
+		return nil
+	}
+	if _, found := l.rules[name]; found {
+		return nil
+	}
+	n := 0
+	for k := range l.rules {
+		if strings.HasPrefix(k, blocklistRulePrefix) {
+			n++
+		}
+	}
+	if n >= maxBlocklistRules {
+		return fmt.Errorf("rule %q refused: %d blocklist rules already loaded", name, n)
+	}
+	return nil
+}
diff --git a/daemon/rule/ui_blocklist_test.go b/daemon/rule/ui_blocklist_test.go
new file mode 100644
index 00000000..6ce97785
--- /dev/null
+++ b/daemon/rule/ui_blocklist_test.go
@@ -0,0 +1,382 @@
+package rule
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/evilsocket/opensnitch/daemon/ui/protocol"
+)
+
+func useBlocklistsRoot(t *testing.T, root string) {
+	old := BlocklistsRoot
+	BlocklistsRoot = root
+	t.Cleanup(func() { BlocklistsRoot = old })
+}
+
+func blocklistRule(name, typ, operand, data string) *protocol.Rule {
+	return &protocol.Rule{Name: name, Enabled: true, Action: "deny", Duration: "always",
+		Operator: &protocol.Operator{Type: typ, Operand: operand, Data: data}}
+}
+
+func TestDefaultBlocklistsRootIsCleanAndLiteral(t *testing.T) {
+	if strings.ContainsAny(BlocklistsRoot, `*?[]\`) || !filepath.IsAbs(BlocklistsRoot) || filepath.Clean(BlocklistsRoot) != BlocklistsRoot {
+		t.Errorf("BlocklistsRoot %q must be absolute, clean and glob-free", BlocklistsRoot)
+	}
+	if !strings.HasPrefix(BlocklistsRoot, SnitchwatchRoot+"/") || filepath.Clean(SnitchwatchRoot) != SnitchwatchRoot {
+		t.Errorf("BlocklistsRoot %q must be inside the confined tree %q", BlocklistsRoot, SnitchwatchRoot)
+	}
+}
+
+// A lists rule makes the root daemon read every file in its data directory,
+// so the UI channel may only add one whose directory is derived from its name.
+func TestDeserializeBlocklistRules(t *testing.T) {
+	root := t.TempDir()
+	useBlocklistsRoot(t, root)
+	hex := "0123456789abcdef"
+	accepted := map[string]*protocol.Rule{
+		"domains":        blocklistRule("z00-blocklist:ads:domains", "lists", "lists.domains", root+"/ads/domains"),
+		"ips":            blocklistRule("z00-blocklist:bad_ips-1:ips", "lists", "lists.ips", root+"/bad_ips-1/ips"),
+		"hashed list":    blocklistRule("z00-blocklist:ads."+hex+":domains", "lists", "lists.domains", root+"/ads."+hex+"/domains"),
+		"81-char list":   blocklistRule("z00-blocklist:"+strings.Repeat("a", 81)+":ips", "lists", "lists.ips", root+"/"+strings.Repeat("a", 81)+"/ips"),
+		"40-char hashed": blocklistRule("z00-blocklist:"+strings.Repeat("a", 40)+"."+hex+":ips", "lists", "lists.ips", root+"/"+strings.Repeat("a", 40)+"."+hex+"/ips"),
+	}
+	for name, r := range accepted {
+		if got, err := DeserializeChange(r); err != nil || got == nil {
+			t.Errorf("%s: refused: %v", name, err)
+		}
+		// AskRule replies come from packet workers and never add lists.
+		if got, err := Deserialize(r); err == nil || got != nil {
+			t.Errorf("%s: accepted on the ask path", name)
+		}
+	}
+
+	ok := func(mod func(r *protocol.Rule)) *protocol.Rule {
+		r := blocklistRule("z00-blocklist:ads:domains", "lists", "lists.domains", root+"/ads/domains")
+		mod(r)
+		return r
+	}
+	named := func(list, kind, operand string) *protocol.Rule {
+		return blocklistRule("z00-blocklist:"+list+":"+kind, "lists", operand, root+"/"+list+"/"+kind)
+	}
+	refused := map[string]*protocol.Rule{
+		"wrong root":       ok(func(r *protocol.Rule) { r.Operator.Data = "/tmp/ads/domains" }),
+		"default root":     ok(func(r *protocol.Rule) { r.Operator.Data = "/var/lib/snitchwatch/blocklists/ads/domains" }),
+		"trailing slash":   ok(func(r *protocol.Rule) { r.Operator.Data += "/" }),
+		"dotdot":           ok(func(r *protocol.Rule) { r.Operator.Data = root + "/ads/../ads/domains" }),
+		"extra segment":    ok(func(r *protocol.Rule) { r.Operator.Data += "/x" }),
+		"other list":       ok(func(r *protocol.Rule) { r.Operator.Data = root + "/other/domains" }),
+		"kind mismatch":    ok(func(r *protocol.Rule) { r.Operator.Operand = "lists.ips" }),
+		"data kind":        ok(func(r *protocol.Rule) { r.Operator.Data = root + "/ads/ips" }),
+		"82-char list":     named(strings.Repeat("a", 82), "ips", "lists.ips"),
+		"41-char hashed":   named(strings.Repeat("a", 41)+"."+hex, "ips", "lists.ips"),
+		"uppercase hex":    named("ads.0123456789ABCDEF", "ips", "lists.ips"),
+		"short hex":        named("ads.0123456789abcde", "ips", "lists.ips"),
+		"dot in list":      named("a.b", "ips", "lists.ips"),
+		"dotdot list":      named("..", "ips", "lists.ips"),
+		"slash in list":    named("a/b", "ips", "lists.ips"),
+		"newline name":     ok(func(r *protocol.Rule) { r.Name += "\n" }),
+		"name prefix":      ok(func(r *protocol.Rule) { r.Name = "x" + r.Name }),
+		"action allow":     ok(func(r *protocol.Rule) { r.Action = "allow" }),
+		"duration once":    ok(func(r *protocol.Rule) { r.Duration = "once" }),
+		"until restart":    ok(func(r *protocol.Rule) { r.Duration = "until restart" }),
+		"precedence":       ok(func(r *protocol.Rule) { r.Precedence = true }),
+		"sensitive":        ok(func(r *protocol.Rule) { r.Operator.Sensitive = true }),
+		"lists with list":  ok(func(r *protocol.Rule) { r.Operator.List = []*protocol.Operator{simple("dest.ip", "1.1.1.1")} }),
+		"lists, non-lists": ok(func(r *protocol.Rule) { r.Operator.Operand = "dest.host" }),
+		"simple, lists":    ok(func(r *protocol.Rule) { r.Operator.Type = "simple" }),
+		"domains_regexp":   ok(func(r *protocol.Rule) { r.Operator.Operand = "lists.domains_regexp" }),
+		"nets":             ok(func(r *protocol.Rule) { r.Operator.Operand = "lists.nets" }),
+		"hash.md5":         ok(func(r *protocol.Rule) { r.Operator.Operand = "lists.hash.md5" }),
+		"non-blocklist":    ok(func(r *protocol.Rule) { r.Name = "my-rule" }),
+		"nested in list": ok(func(r *protocol.Rule) {
+			r.Operator = &protocol.Operator{Type: "list", Operand: "list", List: []*protocol.Operator{r.Operator}}
+		}),
+		"nested simple lists operand": ok(func(r *protocol.Rule) {
+			r.Operator = &protocol.Operator{Type: "list", Operand: "list", List: []*protocol.Operator{
+				simple("process.path", "/usr/bin/curl"), simple("lists.domains", r.Operator.Data)}}
+		}),
+		"nested with app": ok(func(r *protocol.Rule) {
+			r.Operator = &protocol.Operator{Type: "list", Operand: "list", List: []*protocol.Operator{
+				{Type: "simple", Operand: "process.path", Data: "/usr/bin/curl"}, r.Operator}}
+		}),
+	}
+	for name, r := range refused {
+		if got, err := DeserializeChange(r); err == nil || got != nil {
+			t.Errorf("%s: accepted", name)
+		}
+	}
+}
+
+// Each blocklist rule is a lists monitor plus up to 80 MiB of list, so the UI
+// channel may hold at most maxBlocklistRules of them; replacing one is fine.
+func TestLoaderCapsBlocklistRules(t *testing.T) {
+	l, err := NewLoader(false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := l.Load(t.TempDir()); err != nil {
+		t.Fatal(err)
+	}
+	op, _ := NewOperator(Simple, false, OpTrue, "", nil)
+	rule := func(name string) *Rule { return Create(name, "", false, false, false, Deny, Restart, op) }
+	for i := 0; i < maxBlocklistRules; i++ {
+		if err := l.Replace(rule(fmt.Sprintf("z00-blocklist:l%d:domains", i)), false); err != nil {
+			t.Fatalf("rule %d refused: %v", i, err)
+		}
+	}
+	if err := l.Replace(rule("z00-blocklist:new:domains"), false); err == nil {
+		t.Error("Replace accepted a new blocklist rule over the cap")
+	}
+	if err := l.Add(rule("z00-blocklist:new:ips"), false); err == nil {
+		t.Error("Add accepted a new blocklist rule over the cap")
+	}
+	if err := l.Add(rule("z00-blocklist:l0:domains"), false); err == nil {
+		t.Error("Add accepted a renamed duplicate blocklist rule over the cap")
+	}
+	if err := l.Replace(rule("z00-blocklist:l0:domains"), false); err != nil {
+		t.Errorf("replacing an existing blocklist rule refused: %v", err)
+	}
+	if err := l.Replace(rule("other-rule"), false); err != nil {
+		t.Errorf("non-blocklist rule refused: %v", err)
+	}
+	if n := len(l.GetAll()); n != maxBlocklistRules+1 {
+		t.Errorf("%d rules loaded, want %d", n, maxBlocklistRules+1)
+	}
+}
+
+// Concurrent same-name Adds and Replaces of enabled blocklist rules must never
+// exceed the cap, and once everything is deleted every lists monitor and
+// every budget byte must be gone (displaced and refused rules included).
+func TestLoaderBlocklistRulesConcurrent(t *testing.T) {
+	blk := useSnitchwatchRoot(t)
+	useConfinedTimings(t, 10*time.Millisecond, 0)
+	writeFile(t, blk+"/ads/domains/domains.list", "0.0.0.0 a.example\n")
+	l, err := NewLoader(false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := l.Load(t.TempDir()); err != nil {
+		t.Fatal(err)
+	}
+	mkNamed := func(name string) *Rule {
+		op, _ := NewOperator(Lists, false, OpDomainsLists, blk+"/ads/domains", nil)
+		return Create(name, "", true, false, false, Deny, Always, op)
+	}
+	mk := func() *Rule { return mkNamed("z00-blocklist:ads:domains") }
+	// Fill to just under the cap so the concurrent burst races the boundary.
+	for i := 0; i < maxBlocklistRules-2; i++ {
+		if err := l.Add(mk(), false); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 100; i++ {
+		wg.Add(3)
+		go func() { defer wg.Done(); l.Replace(mk(), false) }()
+		go func() { defer wg.Done(); l.Add(mk(), false) }()
+		go func(i int) { defer wg.Done(); l.Replace(mkNamed(fmt.Sprintf("z00-blocklist:n%d:domains", i)), false) }(i)
+	}
+	wg.Wait()
+	l.RLock()
+	names := make([]string, 0, len(l.rules))
+	for name := range l.rules {
+		names = append(names, name)
+	}
+	l.RUnlock()
+	if len(names) > maxBlocklistRules {
+		t.Errorf("%d blocklist rules loaded, cap is %d", len(names), maxBlocklistRules)
+	}
+	for _, name := range names {
+		l.Delete(name)
+	}
+	waitSettled(t, "after delete")
+}
+
+// waitSettled waits up to 5 s for every lists monitor to exit and the budget
+// to be fully released.
+func waitSettled(t *testing.T, what string) {
+	t.Helper()
+	for deadline := time.Now().Add(5 * time.Second); liveListsMonitors.Load() != 0 || budgetUsed() != 0; time.Sleep(5 * time.Millisecond) {
+		if time.Now().After(deadline) {
+			t.Fatalf("%s: %d lists monitors still running, %d budget bytes held", what, liveListsMonitors.Load(), budgetUsed())
+		}
+	}
+}
+
+// Every lists monitor a rule starts is stopped when the rule fails to
+// compile, is deleted (all list sub-operators, not just the first) or, if
+// temporary, expires.
+func TestLoaderStopsAllListsMonitors(t *testing.T) {
+	blk := useSnitchwatchRoot(t)
+	useConfinedTimings(t, 10*time.Millisecond, 0)
+	writeFile(t, blk+"/ads/domains/domains.list", "0.0.0.0 a.example\n")
+	writeFile(t, blk+"/ads/ips/ips.list", "10.0.0.1\n")
+	l, err := NewLoader(false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := l.Load(t.TempDir()); err != nil {
+		t.Fatal(err)
+	}
+	listRule := func(name string, d Duration, typ Type, operand Operand, data string) *Rule {
+		op := &Operator{Type: List, Operand: OpList, List: []Operator{
+			{Type: Lists, Operand: OpDomainsLists, Data: blk + "/ads/domains"},
+			{Type: Lists, Operand: OpIPLists, Data: blk + "/ads/ips"},
+			{Type: typ, Operand: operand, Data: data},
+		}}
+		return Create(name, "", true, false, false, Deny, d, op)
+	}
+	if err := l.Replace(listRule("bad", Always, Regexp, OpDstHost, "("), false); err == nil {
+		t.Fatal("uncompilable rule accepted")
+	}
+	waitSettled(t, "compile failure")
+	if err := l.Replace(listRule("two-lists", Always, Simple, OpDstPort, "443"), false); err != nil {
+		t.Fatal(err)
+	}
+	l.Delete("two-lists")
+	waitSettled(t, "delete")
+	if err := l.Replace(listRule("temporary", Duration("50ms"), Simple, OpDstPort, "443"), false); err != nil {
+		t.Fatal(err)
+	}
+	waitSettled(t, "expiry")
+}
+
+// Names are validated before anything else, on both UI paths, and Rule.String
+// quotes them so a name can't forge a log line.
+func TestDeserializeValidatesNamesAndStringQuotes(t *testing.T) {
+	r := uiRule(simple("dest.port", "443"))
+	r.Name = "x\nforged"
+	if got, err := Deserialize(r); err == nil || got != nil {
+		t.Error("ask path accepted a bad name")
+	}
+	if got, err := DeserializeChange(r); err == nil || got != nil {
+		t.Error("change path accepted a bad name")
+	}
+	op, _ := NewOperator(Simple, false, OpDstHost, "a\nb", nil)
+	if s := Create("x\nforged", "", true, false, false, Deny, Always, op).String(); strings.Contains(s, "\n") {
+		t.Errorf("String() has a raw newline: %q", s)
+	}
+}
+
+// Add renames on a clash; the renamed name must still be a valid one.
+func TestLoaderAddRevalidatesRenamedNames(t *testing.T) {
+	l, err := NewLoader(false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := l.Load(t.TempDir()); err != nil {
+		t.Fatal(err)
+	}
+	op, _ := NewOperator(Simple, false, OpTrue, "", nil)
+	name := strings.Repeat("a", maxNameBytes)
+	if err := l.Add(Create(name, "", false, false, false, Deny, Restart, op), false); err != nil {
+		t.Fatal(err)
+	}
+	if err := l.Add(Create(name, "", false, false, false, Deny, Restart, op), false); err == nil {
+		t.Error("Add accepted a rename past maxNameBytes")
+	}
+}
+
+// A same-name Replace hands the loaded list to the new rule: the active rule
+// is never empty, no reload happens and only one monitor runs.
+func TestLoaderReplaceFloodHandsOverTheList(t *testing.T) {
+	blk := useSnitchwatchRoot(t)
+	useConfinedTimings(t, 10*time.Millisecond, 0)
+	writeFile(t, blk+"/ads/domains/domains.list", "0.0.0.0 a.example\n0.0.0.0 b.example\n")
+	l, err := NewLoader(false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := l.Load(t.TempDir()); err != nil {
+		t.Fatal(err)
+	}
+	const name = "z00-blocklist:ads:domains"
+	t.Cleanup(func() { l.Delete(name); waitSettled(t, "cleanup") })
+	mk := func() *Rule {
+		op, _ := NewOperator(Lists, false, OpDomainsLists, blk+"/ads/domains", nil)
+		return Create(name, "", true, false, false, Deny, Always, op)
+	}
+	active := func() *Operator {
+		l.RLock()
+		defer l.RUnlock()
+		return &l.rules[name].Operator
+	}
+	if err := l.Replace(mk(), false); err != nil {
+		t.Fatal(err)
+	}
+	waitFor(t, "first load", func() bool { return numLists(active()) == 2 })
+	loads := confinedLoads.Load()
+	for i := 0; i < 1000; i++ {
+		if err := l.Replace(mk(), false); err != nil {
+			t.Fatal(err)
+		}
+		if n := numLists(active()); n != 2 {
+			t.Fatalf("replace %d: active rule has %d entries", i, n)
+		}
+	}
+	waitFor(t, "one monitor", func() bool { return liveListsMonitors.Load() == 1 })
+	time.Sleep(5 * confinedPollInterval)
+	if d := confinedLoads.Load() - loads; d != 0 {
+		t.Errorf("%d reloads during the flood", d)
+	}
+	l.Delete(name)
+	waitSettled(t, "after delete")
+}
+
+// With live reload, CHANGE_RULE's Save echoes back through fsnotify as a new
+// rule; the list is handed over, so it is loaded once and stays loaded.
+func TestLoaderLiveReloadEchoHandsOverTheList(t *testing.T) {
+	blk := useSnitchwatchRoot(t)
+	useConfinedTimings(t, 10*time.Millisecond, 0)
+	writeFile(t, blk+"/ads/domains/domains.list", "0.0.0.0 a.example\n")
+	rules := filepath.Dir(blk) + "/rules"
+	if err := os.Mkdir(rules, 0700); err != nil {
+		t.Fatal(err)
+	}
+	l, err := NewLoader(true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := l.Load(rules); err != nil {
+		t.Fatal(err)
+	}
+	waitFor(t, "rules watcher not running", l.isLiveReloadRunning)
+	time.Sleep(100 * time.Millisecond) // let it add the inotify watch
+	const name = "z00-blocklist:ads:domains"
+	t.Cleanup(func() { l.Delete(name); waitSettled(t, "cleanup") })
+	mk := func() *Rule {
+		op, _ := NewOperator(Lists, false, OpDomainsLists, blk+"/ads/domains", nil)
+		return Create(name, "", true, false, false, Deny, Always, op)
+	}
+	active := func() *Rule {
+		l.RLock()
+		defer l.RUnlock()
+		return l.rules[name]
+	}
+	// Load it first without saving, so the echo below must hand over a
+	// loaded list (insertRule hands over to sent, loadRule to the echo).
+	if err := l.Replace(mk(), false); err != nil {
+		t.Fatal(err)
+	}
+	waitFor(t, "list not loaded", func() bool { return numLists(&active().Operator) == 1 })
+	loads := confinedLoads.Load()
+	sent := mk()
+	if err := l.Replace(sent, true); err != nil {
+		t.Fatal(err)
+	}
+	waitFor(t, "no fsnotify echo", func() bool { return active() != sent })
+	if numLists(&active().Operator) != 1 {
+		t.Error("echoed rule is empty")
+	}
+	time.Sleep(10 * confinedPollInterval)
+	if d := confinedLoads.Load() - loads; d != 0 || numLists(&active().Operator) != 1 || liveListsMonitors.Load() != 1 {
+		t.Errorf("%d reloads, %d entries, %d monitors; want 0, 1, 1", d, numLists(&active().Operator), liveListsMonitors.Load())
+	}
+	l.Delete(name)
+	waitSettled(t, "after delete")
+}
diff --git a/daemon/rule/ui_lists.go b/daemon/rule/ui_lists.go
new file mode 100644
index 00000000..7506fdbd
--- /dev/null
+++ b/daemon/rule/ui_lists.go
@@ -0,0 +1,65 @@
+package rule
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/evilsocket/opensnitch/daemon/ui/protocol"
+)
+
+// maxListOperators bounds a UI-sent list operator; app-bound prompt rules use 2.
+const maxListOperators = 64
+
+// validateUIOperator checks a rule received over the UI channel (Deserialize
+// is only used for those) before the root daemon compiles it:
+//   - lists.* operands make the daemon read every file in a client-chosen
+//     directory, so they are refused;
+//   - each operator type's match callback hard-asserts its value type
+//     (simple/regexp want a string, network a net.IP), and Match picks the
+//     value by operand, so a mismatched pair panics the daemon on the next
+//     matching packet and, saved as "always", crash-loops it;
+//   - an empty list, a nested list (Deserialize copies one level, so it
+//     arrives empty) or a non-simple "true" would match every connection.
+func validateUIOperator(op *protocol.Operator, depth int) error {
+	if op == nil {
+		return fmt.Errorf("missing operator")
+	}
+	typ, operand := Type(op.Type), Operand(op.Operand)
+	if strings.HasPrefix(op.Operand, "lists.") || typ == Lists {
+		return fmt.Errorf("operand %q refused from the UI channel", op.Operand)
+	}
+	switch {
+	case typ == List || operand == OpList:
+		// Compile rewrites a list type's operand to "list" (upstream sends
+		// "true" too), but a "list" operand on another type would match its
+		// empty member list, i.e. everything.
+		if typ != List {
+			return fmt.Errorf("operand list needs the list type, got %s", typ)
+		}
+		if depth > 0 {
+			return fmt.Errorf("nested list operators are refused")
+		}
+		if n := len(op.List); n < 1 || n > maxListOperators {
+			return fmt.Errorf("list operator needs 1-%d members, got %d", maxListOperators, n)
+		}
+		for _, child := range op.List {
+			if err := validateUIOperator(child, depth+1); err != nil {
+				return err
+			}
+		}
+		return nil
+	case operand == OpDstNetwork || operand == OpSrcNetwork || typ == Network:
+		if typ != Network || (operand != OpDstNetwork && operand != OpSrcNetwork) {
+			return fmt.Errorf("network type and network operands must go together (%s/%s)", typ, operand)
+		}
+		return nil
+	case operand == OpTrue:
+		if typ != Simple {
+			return fmt.Errorf("operand true is only valid as a simple operator")
+		}
+		return nil
+	case typ == Simple || typ == Regexp:
+		return nil
+	}
+	return fmt.Errorf("unsupported operator type %q", op.Type)
+}
diff --git a/daemon/rule/ui_operator_test.go b/daemon/rule/ui_operator_test.go
new file mode 100644
index 00000000..db0ba318
--- /dev/null
+++ b/daemon/rule/ui_operator_test.go
@@ -0,0 +1,62 @@
+package rule
+
+import (
+	"testing"
+
+	"github.com/evilsocket/opensnitch/daemon/ui/protocol"
+)
+
+func uiRule(op *protocol.Operator) *protocol.Rule {
+	return &protocol.Rule{Name: "ui-operator", Enabled: true, Action: "deny", Duration: "always", Operator: op}
+}
+
+func simple(operand, data string) *protocol.Operator {
+	return &protocol.Operator{Type: "simple", Operand: operand, Data: data}
+}
+
+// Operator callbacks hard-assert their value type (simpleCmp wants a string,
+// network matchers a net.IP), so a mismatched type/operand pair panics the
+// root daemon on the next matching packet; some shapes match everything.
+func TestDeserializeRefusesUnsafeOperatorShapes(t *testing.T) {
+	refused := map[string]*protocol.Operator{
+		"simple on dest.network":    simple("dest.network", "10.0.0.0/8"),
+		"regexp on source.network":  {Type: "regexp", Operand: "source.network", Data: ".*"},
+		"network on dest.ip":        {Type: "network", Operand: "dest.ip", Data: "10.0.0.0/8"},
+		"network on process.path":   {Type: "network", Operand: "process.path", Data: "10.0.0.0/8"},
+		"list operand, simple type": simple("list", ""),
+		"empty list":                {Type: "list", Operand: "list"},
+		"nested list": {Type: "list", Operand: "list", List: []*protocol.Operator{
+			{Type: "list", Operand: "list", List: []*protocol.Operator{simple("dest.ip", "1.1.1.1")}}}},
+		"true as regexp":  {Type: "regexp", Operand: "true", Data: ".*"},
+		"unknown type":    {Type: "bogus", Operand: "dest.ip", Data: "1.1.1.1"},
+		"65-member list":  {Type: "list", Operand: "list", List: make65()},
+		"mismatch inside": {Type: "list", Operand: "list", List: []*protocol.Operator{simple("process.path", "/usr/bin/curl"), simple("dest.network", "10.0.0.0/8")}},
+	}
+	for name, op := range refused {
+		if r, err := Deserialize(uiRule(op)); err == nil || r != nil {
+			t.Errorf("%s: accepted", name)
+		}
+	}
+	accepted := map[string]*protocol.Operator{
+		"app-bound list": {Type: "list", Operand: "list", List: []*protocol.Operator{
+			{Type: "simple", Operand: "process.path", Data: "/usr/bin/curl", Sensitive: true}, simple("dest.ip", "10.0.2.2")}},
+		"network on dest.network": {Type: "network", Operand: "dest.network", Data: "10.0.0.0/8"},
+		"regexp on dest.host":     {Type: "regexp", Operand: "dest.host", Data: `^(.*\.)?example\.org$`},
+		"simple true":             simple("true", ""),
+		"simple dest.port":        simple("dest.port", "443"),
+		"upstream list form":      {Type: "list", Operand: "true", List: []*protocol.Operator{simple("process.path", "/path/x"), simple("dest.port", "23")}},
+	}
+	for name, op := range accepted {
+		if r, err := Deserialize(uiRule(op)); err != nil || r == nil {
+			t.Errorf("%s: refused: %v", name, err)
+		}
+	}
+}
+
+func make65() []*protocol.Operator {
+	ops := make([]*protocol.Operator, 65)
+	for i := range ops {
+		ops[i] = simple("dest.port", "443")
+	}
+	return ops
+}
diff --git a/daemon/shutdown_signal_test.go b/daemon/shutdown_signal_test.go
new file mode 100644
index 00000000..2908c998
--- /dev/null
+++ b/daemon/shutdown_signal_test.go
@@ -0,0 +1,41 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// Exercise the real signal handler and emergency timer in a separate process;
+// no privileged queues, firewall, or daemon services are started by this test.
+func TestShutdownWatchdogExitsNonzero(t *testing.T) {
+	if os.Getenv("OPENSNITCH_SHUTDOWN_WATCHDOG_CHILD") == "1" {
+		ctx, cancel = context.WithCancel(context.Background())
+		setupSignals()
+		sigChan <- syscall.SIGTERM
+		<-ctx.Done()
+		time.Sleep(12 * time.Second) // deliberately never complete cleanup
+		os.Exit(99)
+	}
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	deadline, stop := context.WithTimeout(context.Background(), 14*time.Second)
+	defer stop()
+	command := exec.CommandContext(deadline, executable, "-test.run=^TestShutdownWatchdogExitsNonzero$")
+	command.Env = append(os.Environ(), "OPENSNITCH_SHUTDOWN_WATCHDOG_CHILD=1")
+	started := time.Now()
+	output, err := command.CombinedOutput()
+	var exited *exec.ExitError
+	if !errors.As(err, &exited) || exited.ExitCode() != 1 {
+		t.Fatalf("forced shutdown must fail, got %v; output%s", err, output)
+	}
+	if elapsed := time.Since(started); elapsed < 9*time.Second || elapsed > 13*time.Second {
+		t.Fatalf("unexpected watchdog bound%s", elapsed)
+	}
+}
diff --git a/daemon/statistics/default_event_test.go b/daemon/statistics/default_event_test.go
new file mode 100644
index 00000000..2876c53a
--- /dev/null
+++ b/daemon/statistics/default_event_test.go
@@ -0,0 +1,158 @@
+package statistics
+
+import (
+	"net"
+	"testing"
+
+	"github.com/evilsocket/opensnitch/daemon/conman"
+	"github.com/evilsocket/opensnitch/daemon/log/loggers"
+	"github.com/evilsocket/opensnitch/daemon/netstat"
+	"github.com/evilsocket/opensnitch/daemon/procmon"
+	"github.com/evilsocket/opensnitch/daemon/rule"
+)
+
+func testConnection() *conman.Connection {
+	proc := procmon.NewProcessEmpty(4242, "curl")
+	proc.Path = "/usr/bin/curl"
+	return &conman.Connection{
+		Protocol: "tcp",
+		SrcIP:    net.ParseIP("10.0.0.2"),
+		DstIP:    net.ParseIP("192.0.2.1"),
+		DstPort:  443,
+		Entry:    &netstat.Entry{UserId: 1000},
+		Process:  proc,
+	}
+}
+
+type counters struct{ conns, hits, misses, accepted, dropped int }
+
+func countersOf(s *Statistics) counters {
+	return counters{s.Connections, s.RuleHits, s.RuleMisses, s.Accepted, s.Dropped}
+}
+
+// A UI-created rule can never carry the synthetic name, so an Event's rule
+// name alone says whether a rule or DefaultAction decided it. "<default>"
+// would not do: ValidName accepts it, so the UI could save a rule so named.
+func TestDefaultActionRuleNameIsRefusedForRealRules(t *testing.T) {
+	if err := rule.ValidName(DefaultActionRuleName); err == nil {
+		t.Fatalf("ValidName accepts %q, so a real rule could collide with default-applied events", DefaultActionRuleName)
+	}
+}
+
+func TestDefaultAppliedConnectionIsRecordedAsEvent(t *testing.T) {
+	for _, action := range []rule.Action{rule.Allow, rule.Deny, rule.Reject} {
+		s := New(nil)
+		s.onConnection(testConnection(), nil, true, action)
+
+		if len(s.Events) != 1 {
+			t.Fatalf("%s: got %d events, want 1", action, len(s.Events))
+		}
+		ev := s.Events[0].Serialize()
+		if ev.Rule == nil {
+			t.Fatalf("%s: event has no rule, so its action is lost", action)
+		}
+		if ev.Rule.Name != DefaultActionRuleName || ev.Rule.Action != string(action) {
+			t.Fatalf("%s: event rule = %q/%q, want %q/%q", action, ev.Rule.Name, ev.Rule.Action, DefaultActionRuleName, action)
+		}
+		if ev.Connection.DstPort != 443 || ev.Connection.ProcessPath != "/usr/bin/curl" {
+			t.Fatalf("%s: event carries the wrong connection: %v", action, ev.Connection)
+		}
+		if !s.newEvents {
+			t.Fatalf("%s: default-applied event is not flagged for the next stats push", action)
+		}
+		// Counters stay exactly upstream's for a missed connection.
+		if got, want := countersOf(s), (counters{conns: 1, misses: 1, dropped: 1}); got != want {
+			t.Fatalf("%s: counters = %+v, want %+v", action, got, want)
+		}
+	}
+}
+
+// The synthetic rule's shape is a contract with Snitchwatch's bridge, which
+// recognises default-applied Events by name == "" and this description.
+func TestDefaultActionRuleShapeIsTheBridgeContract(t *testing.T) {
+	if DefaultActionRuleName != "" || DefaultActionRuleDescription != "snitchwatch:default-action" {
+		t.Fatalf("marker changed to %q/%q without coordinating with the bridge", DefaultActionRuleName, DefaultActionRuleDescription)
+	}
+	s := New(nil)
+	s.onConnection(testConnection(), nil, true, rule.Reject)
+	if len(s.Events) != 1 {
+		t.Fatalf("got %d events, want 1", len(s.Events))
+	}
+	r := s.Events[0].Serialize().Rule
+	if r.Name != "" || r.Description != "snitchwatch:default-action" || r.Action != "reject" ||
+		!r.Enabled || r.Precedence || r.Nolog || r.Duration != string(rule.Once) {
+		t.Fatalf("synthetic rule = %+v", r)
+	}
+	if op := r.Operator; op == nil || op.Type != string(rule.Simple) || op.Operand != string(rule.OpTrue) || op.Data != "" || len(op.List) != 0 {
+		t.Fatalf("synthetic rule operator = %+v, want simple/true", r.Operator)
+	}
+}
+
+func fillEvents(s *Statistics) {
+	op, _ := rule.NewOperator(rule.Simple, false, rule.OpTrue, "", nil)
+	for i := 0; i < s.maxEvents; i++ {
+		s.onConnection(testConnection(), rule.Create("allow-curl", "", true, false, false, rule.Allow, rule.Always, op), false, "")
+	}
+}
+
+// A miss that adds no Event must not evict one from a full ring.
+func TestMissWithoutDefaultActionEvictsNoEvent(t *testing.T) {
+	s := New(nil)
+	fillEvents(s)
+	first := s.Events[0]
+	s.onConnection(testConnection(), nil, true, "")
+	if len(s.Events) != s.maxEvents || s.Events[0] != first {
+		t.Fatalf("a miss with no Event evicted one: %d events, first kept %v", len(s.Events), s.Events[0] == first)
+	}
+}
+
+func TestDefaultEventsStayWithinMaxEvents(t *testing.T) {
+	s := New(nil)
+	fillEvents(s)
+	for i := 0; i < 3*s.maxEvents; i++ {
+		s.onConnection(testConnection(), nil, true, rule.Deny)
+		if len(s.Events) != s.maxEvents {
+			t.Fatalf("after %d default events: %d events, want %d", i+1, len(s.Events), s.maxEvents)
+		}
+	}
+	if s.Events[0].Rule.Name != DefaultActionRuleName {
+		t.Fatal("default events did not shift the oldest events out")
+	}
+}
+
+// A miss nobody applied DefaultAction to (a failed repeat-queue hand-off;
+// busy-slot drops never reach statistics) still counts, as upstream, but is
+// not an Event.
+func TestMissWithoutDefaultActionIsNotAnEvent(t *testing.T) {
+	s := New(nil)
+	s.onConnection(testConnection(), nil, true, "")
+	if len(s.Events) != 0 || s.newEvents {
+		t.Fatalf("a miss without DefaultAction became an event: %d", len(s.Events))
+	}
+	if got, want := countersOf(s), (counters{conns: 1, misses: 1, dropped: 1}); got != want {
+		t.Fatalf("counters = %+v, want %+v", got, want)
+	}
+}
+
+func TestRuleMatchedEventIsUnchanged(t *testing.T) {
+	op, _ := rule.NewOperator(rule.Simple, false, rule.OpTrue, "", nil)
+	r := rule.Create("allow-curl", "", true, false, false, rule.Allow, rule.Always, op)
+	s := New(nil)
+	s.onConnection(testConnection(), r, false, "")
+	if len(s.Events) != 1 || s.Events[0].Rule != r {
+		t.Fatalf("rule-matched event does not carry the matched rule: %v", s.Events)
+	}
+	if got, want := countersOf(s), (counters{conns: 1, hits: 1, accepted: 1}); got != want {
+		t.Fatalf("counters = %+v, want %+v", got, want)
+	}
+}
+
+func TestOnDefaultActionEventQueuesAMissWithItsAction(t *testing.T) {
+	s := New(nil)
+	s.SetLoggers(loggers.NewLoggerManager())
+	go s.OnDefaultActionEvent(testConnection(), rule.Deny)
+	job := <-s.jobs
+	if job.match != nil || !job.wasMissed || job.defaultAction != rule.Deny {
+		t.Fatalf("queued job = match %v, missed %v, action %q; want nil, true, deny", job.match, job.wasMissed, job.defaultAction)
+	}
+}
diff --git a/daemon/ui/client_asking_test.go b/daemon/ui/client_asking_test.go
new file mode 100644
index 00000000..27146ae7
--- /dev/null
+++ b/daemon/ui/client_asking_test.go
@@ -0,0 +1,41 @@
+package ui
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+func TestTryStartAskingHasExactlyOneWinner(t *testing.T) {
+	for round := 0; round < 50; round++ {
+		c := &Client{}
+		var wins int32
+		var ready, done sync.WaitGroup
+		gate := make(chan struct{})
+		for i := 0; i < 32; i++ {
+			ready.Add(1)
+			done.Add(1)
+			go func() {
+				defer done.Done()
+				ready.Done()
+				<-gate
+				if c.TryStartAsking() {
+					atomic.AddInt32(&wins, 1)
+				}
+			}()
+		}
+		ready.Wait()
+		close(gate)
+		done.Wait()
+		if wins != 1 {
+			t.Fatalf("round %d: %d workers claimed the prompt slot", round, wins)
+		}
+		if !c.GetIsAsking() {
+			t.Fatal("winner did not mark the slot taken")
+		}
+		c.SetIsAsking(false)
+		if !c.TryStartAsking() {
+			t.Fatal("released slot cannot be claimed again")
+		}
+	}
+}
diff --git a/daemon/ui/client_shutdown_test.go b/daemon/ui/client_shutdown_test.go
new file mode 100644
index 00000000..225eb35d
--- /dev/null
+++ b/daemon/ui/client_shutdown_test.go
@@ -0,0 +1,216 @@
+package ui
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"github.com/evilsocket/opensnitch/daemon/conman"
+	"github.com/evilsocket/opensnitch/daemon/log"
+	"github.com/evilsocket/opensnitch/daemon/netstat"
+	"github.com/evilsocket/opensnitch/daemon/procmon"
+	"github.com/evilsocket/opensnitch/daemon/tasks"
+	"github.com/evilsocket/opensnitch/daemon/ui/protocol"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/grpc/test/bufconn"
+	"net"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+type shutdownUIServer struct {
+	protocol.UnimplementedUIServer
+	entered  chan time.Time
+	canceled chan struct{}
+}
+
+func (s *shutdownUIServer) AskRule(ctx context.Context, c *protocol.Connection) (*protocol.Rule, error) {
+	deadline, _ := ctx.Deadline()
+	s.entered <- deadline
+	<-ctx.Done()
+	close(s.canceled)
+	return nil, status.Error(codes.Canceled, "client shutdown")
+}
+func (s *shutdownUIServer) Ping(ctx context.Context, p *protocol.PingRequest) (*protocol.PingReply, error) {
+	return &protocol.PingReply{Id: p.Id}, nil
+}
+
+func TestClientCloseCancelsRealAskRPCWithOriginalInteractiveDeadline(t *testing.T) {
+	listener := bufconn.Listen(1024 * 1024)
+	defer listener.Close()
+	server := grpc.NewServer()
+	defer server.Stop()
+	service := &shutdownUIServer{entered: make(chan time.Time, 1), canceled: make(chan struct{})}
+	protocol.RegisterUIServer(server, service)
+	go server.Serve(listener)
+	dialctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	conn, err := grpc.DialContext(dialctx, "bufnet", grpc.WithContextDialer(func(context.Context, string) (net.Conn, error) { return listener.Dial() }), grpc.WithInsecure(), grpc.WithBlock())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	ctx, stop := context.WithCancel(context.Background())
+	defer stop()
+	client := &Client{client: protocol.NewUIClient(conn), clientCtx: ctx, clientCancel: stop}
+	previous := TaskMgr
+	TaskMgr = &tasks.TaskManager{}
+	defer func() { TaskMgr = previous }()
+	logs, createErr := os.Create(t.TempDir() + "/ask.log")
+	if createErr != nil {
+		t.Fatal(createErr)
+	}
+	defer logs.Close()
+	previousOutput := log.Output
+	log.Output = logs
+	defer func() { log.Output = previousOutput }()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		r, err := client.AskWithError(&conman.Connection{Entry: &netstat.Entry{}, Process: procmon.NewProcessEmpty(0, "shutdown-test")})
+		if r != nil || !errors.Is(err, ErrClientShutdown) {
+			t.Errorf("canceled Ask outcome: rule=%v error=%v", r, err)
+		}
+	}()
+	select {
+	case deadline := <-service.entered:
+		remaining := time.Until(deadline)
+		if remaining < 119*time.Second || remaining > 121*time.Second {
+			t.Fatalf("interactive deadline changed: %s", remaining)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("real Ask never arrived")
+	}
+	client.Close()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("Close did not cancel Ask")
+	}
+	select {
+	case <-service.canceled:
+	case <-time.After(time.Second):
+		t.Fatal("server RPC context not canceled")
+	}
+	if strings.Contains(readAskLogs(t, logs), "Error while asking for rule") {
+		t.Fatalf("normal shutdown logged RPC error: %s", readAskLogs(t, logs))
+	}
+	// Retain transport and prove cancellation was per Ask, not whole-channel loss.
+	pingctx, pingcancel := context.WithTimeout(context.Background(), time.Second)
+	defer pingcancel()
+	if reply, err := protocol.NewUIClient(conn).Ping(pingctx, &protocol.PingRequest{Id: 42}); err != nil || reply.Id != 42 {
+		t.Fatalf("retained channel failed: %v", err)
+	}
+}
+
+// A remote cancellation while the local client remains open is not shutdown.
+// Unavailable and malformed replies still take the existing visible fallback.
+type shutdownReplyClient struct {
+	protocol.UIClient
+	err          error
+	reply        *protocol.Rule
+	beforeReturn func()
+}
+
+func (c shutdownReplyClient) AskRule(context.Context, *protocol.Connection, ...grpc.CallOption) (*protocol.Rule, error) {
+	if c.beforeReturn != nil {
+		c.beforeReturn()
+	}
+	return c.reply, c.err
+}
+func TestAskFailureIsShutdownOnlyWhenLocalContextCanceled(t *testing.T) {
+	for _, code := range []codes.Code{codes.Canceled, codes.Unavailable, codes.DeadlineExceeded, codes.Internal} {
+		t.Run(code.String(), func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			c := &Client{clientCtx: ctx, client: shutdownReplyClient{err: status.Error(code, "genuine failure")}}
+			logs, createErr := os.Create(t.TempDir() + "/ask.log")
+			if createErr != nil {
+				t.Fatal(createErr)
+			}
+			defer logs.Close()
+			previous := log.Output
+			log.Output = logs
+			defer func() { log.Output = previous }()
+			r, err := c.AskWithError(&conman.Connection{Entry: &netstat.Entry{}, Process: procmon.NewProcessEmpty(0, "failure-test")})
+			if r != nil || errors.Is(err, ErrClientShutdown) || status.Code(err) != code {
+				t.Fatalf("genuine failure misclassified: %v %v", r, err)
+			}
+			if !strings.Contains(readAskLogs(t, logs), "Error while asking for rule") {
+				t.Fatal("genuine RPC error was hidden")
+			}
+		})
+	}
+}
+
+func readAskLogs(t *testing.T, file *os.File) string {
+	t.Helper()
+	data, err := os.ReadFile(file.Name())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(data)
+}
+
+func TestPlainRemoteContextCancellationIsNotLocalShutdown(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	c := &Client{clientCtx: ctx, client: shutdownReplyClient{err: context.Canceled}}
+	logs, err := os.Create(t.TempDir() + "/plain-context.log")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer logs.Close()
+	previous := log.Output
+	log.Output = logs
+	defer func() { log.Output = previous }()
+	_, err = c.AskWithError(&conman.Connection{Entry: &netstat.Entry{}, Process: procmon.NewProcessEmpty(0, "remote-context-test")})
+	if !errors.Is(err, context.Canceled) || errors.Is(err, ErrClientShutdown) {
+		t.Fatalf("remote context error misclassified: %v", err)
+	}
+	if !strings.Contains(readAskLogs(t, logs), "Error while asking for rule") {
+		t.Fatal("remote context error hidden")
+	}
+	cancel()
+	_, err = c.AskWithError(&conman.Connection{})
+	if !errors.Is(err, ErrClientShutdown) {
+		t.Fatalf("already closed client: %v", err)
+	}
+}
+
+func TestMalformedReplyAndNoncancelFailureSurviveConcurrentClose(t *testing.T) {
+	for _, closing := range []bool{false, true} {
+		for _, rpcError := range []bool{false, true} {
+			t.Run(fmt.Sprintf("closing=%v/rpcError=%v", closing, rpcError), func(t *testing.T) {
+				ctx, cancel := context.WithCancel(context.Background())
+				defer cancel()
+				rpc := shutdownReplyClient{reply: &protocol.Rule{Name: "malformed", Action: "allow", Duration: "once"}}
+				if rpcError {
+					rpc.err = status.Error(codes.Unavailable, "genuine service failure")
+				}
+				if closing {
+					rpc.beforeReturn = cancel
+				}
+				c := &Client{clientCtx: ctx, client: rpc}
+				logs, err := os.Create(t.TempDir() + "/malformed.log")
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer logs.Close()
+				previous := log.Output
+				log.Output = logs
+				defer func() { log.Output = previous }()
+				r, err := c.AskWithError(&conman.Connection{Entry: &netstat.Entry{}, Process: procmon.NewProcessEmpty(0, "malformed-test")})
+				if r != nil || err == nil || errors.Is(err, ErrClientShutdown) {
+					t.Fatalf("noncancel failure hidden: rule=%v error=%v", r, err)
+				}
+				if !strings.Contains(readAskLogs(t, logs), "Error while asking for rule") {
+					t.Fatal("noncancel failure was not logged")
+				}
+			})
+		}
+	}
+}
diff --git a/daemon/ui/drop_while_asking_test.go b/daemon/ui/drop_while_asking_test.go
new file mode 100644
index 00000000..901a8c27
--- /dev/null
+++ b/daemon/ui/drop_while_asking_test.go
@@ -0,0 +1,60 @@
+package ui
+
+import (
+	"sync"
+	"testing"
+
+	"github.com/evilsocket/opensnitch/daemon/ui/config"
+)
+
+func TestDropWhileAskingIsOffUnlessTheConfigFileSetsIt(t *testing.T) {
+	for raw, want := range map[string]bool{
+		`{"DefaultAction": "deny"}`:                           false,
+		`{"DefaultAction": "deny", "DropWhileAsking": false}`: false,
+		`{"DefaultAction": "deny", "DropWhileAsking": true}`:  true,
+	} {
+		cfg, err := config.Parse(raw)
+		if err != nil {
+			t.Fatalf("%s: %v", raw, err)
+		}
+		c := &Client{config: cfg}
+		if got := c.DropWhileAsking(); got != want {
+			t.Fatalf("%s: DropWhileAsking() = %v, want %v", raw, got, want)
+		}
+	}
+}
+
+// loadConfiguration swaps c.config under the client lock on every reload; the
+// packet workers read the option concurrently and must see either value.
+// This mirrors that swap instead of calling loadConfiguration, whose
+// reloadConfiguration also reloads rules, the process monitor and the
+// firewall, which a unit test cannot do without root and a real system.
+func TestDropWhileAskingFollowsConfigReloads(t *testing.T) {
+	c := &Client{}
+	var wg sync.WaitGroup
+	stop := make(chan struct{})
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for {
+				select {
+				case <-stop:
+					return
+				default:
+					c.DropWhileAsking()
+				}
+			}
+		}()
+	}
+	for i := 0; i < 200; i++ {
+		c.Lock()
+		c.config = config.Config{DropWhileAsking: i%2 == 0}
+		c.Unlock()
+	}
+	close(stop)
+	wg.Wait()
+	if c.DropWhileAsking() {
+		t.Fatal("last reload turned DropWhileAsking off, but the client still reports it on")
+	}
+}
diff --git a/daemon/ui/notification_policy.go b/daemon/ui/notification_policy.go
new file mode 100644
index 00000000..90c2b7d6
--- /dev/null
+++ b/daemon/ui/notification_policy.go
@@ -0,0 +1,24 @@
+package ui
+
+import (
+	"errors"
+
+	"github.com/evilsocket/opensnitch/daemon/ui/protocol"
+)
+
+// uiAllowedActions are the notifications the Snitchwatch system bridge sends:
+// rule edits and deletes. Every other action hands the root daemon
+// client-chosen configuration paths, firewall rules (including NAT), or task
+// targets (another process's environment and memory map), so the system
+// variant refuses it. Re-enabling one needs its own range-checked security
+// review; do not just add it here.
+var uiAllowedActions = map[protocol.Action]bool{
+	protocol.Action_CHANGE_RULE: true,
+	protocol.Action_DELETE_RULE: true,
+}
+
+var errActionRefused = errors.New("notification action refused: the system-bridge daemon accepts only CHANGE_RULE and DELETE_RULE")
+
+func uiActionAllowed(action protocol.Action) bool {
+	return uiAllowedActions[action]
+}
diff --git a/daemon/ui/notification_policy_test.go b/daemon/ui/notification_policy_test.go
new file mode 100644
index 00000000..e3994db4
--- /dev/null
+++ b/daemon/ui/notification_policy_test.go
@@ -0,0 +1,135 @@
+package ui
+
+import (
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/evilsocket/opensnitch/daemon/rule"
+	"github.com/evilsocket/opensnitch/daemon/ui/protocol"
+	"google.golang.org/grpc"
+)
+
+type replyRecorder struct {
+	grpc.ClientStream
+	replies []*protocol.NotificationReply
+}
+
+func (r *replyRecorder) Send(reply *protocol.NotificationReply) error {
+	r.replies = append(r.replies, reply)
+	return nil
+}
+
+func (r *replyRecorder) Recv() (*protocol.Notification, error) { return nil, io.EOF }
+
+func policyLoader(t *testing.T) (*rule.Loader, string) {
+	t.Helper()
+	dir := t.TempDir()
+	l, err := rule.NewLoader(false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := l.Load(dir); err != nil {
+		t.Fatal(err)
+	}
+	return l, dir
+}
+
+func allowRule(name string, op *protocol.Operator) *protocol.Rule {
+	return &protocol.Rule{Name: name, Enabled: true, Action: "allow", Duration: "always", Operator: op}
+}
+
+// Every action the bridge does not send reaches root with client-chosen paths,
+// firewall rules or task targets; the system variant refuses them with an
+// error reply and no side effect.
+// CHANGE_CONFIG is checked through uiActionAllowed only: driving it through
+// handleNotification would need the global configFile redirected, which
+// races upstream tests (and, on a policy regression, would write the real
+// config).
+func TestNotificationsOutsideTheBridgeSetAreRefused(t *testing.T) {
+	l, dir := policyLoader(t)
+	c := &Client{rules: l}
+	for value, name := range protocol.Action_name {
+		action := protocol.Action(value)
+		bridge := action == protocol.Action_CHANGE_RULE || action == protocol.Action_DELETE_RULE
+		if uiActionAllowed(action) != bridge {
+			t.Errorf("%s: uiActionAllowed = %v", name, !bridge)
+		}
+		if bridge || action == protocol.Action_CHANGE_CONFIG {
+			continue
+		}
+		stream := &replyRecorder{}
+		c.handleNotification(stream, &protocol.Notification{Id: 7, Type: action,
+			Data:  `{"Rules":{"Path":"/var/tmp/x"},"Stats":{"Workers":-1}}`,
+			Rules: []*protocol.Rule{allowRule("refused-"+name, &protocol.Operator{Type: "simple", Operand: "true"})}})
+		if len(stream.replies) != 1 || stream.replies[0].Code != protocol.NotificationReplyCode_ERROR || stream.replies[0].Id != 7 {
+			t.Errorf("%s: want one error reply for id 7, got %v", name, stream.replies)
+		}
+	}
+	if entries, _ := os.ReadDir(dir); len(entries) != 0 || len(l.GetAll()) != 0 {
+		t.Errorf("a refused action changed the rules: %v", entries)
+	}
+}
+
+func TestBridgeRuleNotificationsStillWork(t *testing.T) {
+	l, dir := policyLoader(t)
+	c := &Client{rules: l}
+	name := "snitchwatch-allow-10.0.2.2-f9292b96ff7d66ab-49190-pcurl-f0da955d46aa49e3"
+	op := &protocol.Operator{Type: "list", Operand: "list", List: []*protocol.Operator{
+		{Type: "simple", Operand: "process.path", Data: "/usr/bin/curl", Sensitive: true},
+		{Type: "simple", Operand: "dest.ip", Data: "10.0.2.2"}}}
+	stream := &replyRecorder{}
+	c.handleNotification(stream, &protocol.Notification{Id: 1, Type: protocol.Action_CHANGE_RULE, Rules: []*protocol.Rule{allowRule(name, op)}})
+	if len(stream.replies) != 1 || stream.replies[0].Code != protocol.NotificationReplyCode_OK {
+		t.Fatalf("CHANGE_RULE refused: %v", stream.replies)
+	}
+	if _, err := os.Stat(filepath.Join(dir, name+".json")); err != nil {
+		t.Fatalf("CHANGE_RULE did not save the rule: %v", err)
+	}
+	stream = &replyRecorder{}
+	c.handleNotification(stream, &protocol.Notification{Id: 2, Type: protocol.Action_DELETE_RULE, Rules: []*protocol.Rule{{Name: name}}})
+	if len(stream.replies) != 1 || stream.replies[0].Code != protocol.NotificationReplyCode_OK {
+		t.Fatalf("DELETE_RULE refused: %v", stream.replies)
+	}
+	if _, err := os.Stat(filepath.Join(dir, name+".json")); !os.IsNotExist(err) {
+		t.Fatalf("DELETE_RULE did not delete the rule: %v", err)
+	}
+}
+
+// A lists.* operand makes root read every file in a client-chosen directory,
+// even nested inside a list operator.
+func TestRuleNotificationsRefuseListsOperands(t *testing.T) {
+	l, dir := policyLoader(t)
+	c := &Client{rules: l}
+	for _, op := range []*protocol.Operator{
+		{Type: "lists", Operand: "lists.domains", Data: "/etc/ssl/private"},
+		{Type: "list", Operand: "list", List: []*protocol.Operator{
+			{Type: "simple", Operand: "process.path", Data: "/usr/bin/curl"},
+			{Type: "lists", Operand: "lists.ips", Data: "/root"}}},
+	} {
+		stream := &replyRecorder{}
+		c.handleNotification(stream, &protocol.Notification{Id: 3, Type: protocol.Action_CHANGE_RULE, Rules: []*protocol.Rule{allowRule("lists-rule", op)}})
+		if len(stream.replies) != 1 || stream.replies[0].Code != protocol.NotificationReplyCode_ERROR {
+			t.Errorf("lists operand %v accepted: %v", op, stream.replies)
+		}
+	}
+	if entries, _ := os.ReadDir(dir); len(entries) != 0 || len(l.GetAll()) != 0 {
+		t.Errorf("a lists rule was stored: %v", entries)
+	}
+}
+
+// ENABLE_RULE and DISABLE_RULE are refused by the policy, but their handlers
+// must still not dereference a rule that Deserialize refused.
+func TestEnableDisableHandleRefusedRules(t *testing.T) {
+	l, _ := policyLoader(t)
+	c := &Client{rules: l}
+	bad := allowRule("bad\nname", &protocol.Operator{Type: "simple", Operand: "true"})
+	for _, handle := range []func(protocol.UI_NotificationsClient, *protocol.Notification){c.handleActionEnableRule, c.handleActionDisableRule} {
+		stream := &replyRecorder{}
+		handle(stream, &protocol.Notification{Id: 9, Rules: []*protocol.Rule{bad}})
+		if len(stream.replies) != 1 || stream.replies[0].Code != protocol.NotificationReplyCode_ERROR {
+			t.Errorf("want one error reply, got %v", stream.replies)
+		}
+	}
+}
