+			setup: func(t *testing.T, blk, out string) { writeFile(t, blk+"/ads/domains/domains.list", two) }},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			// out is on the same (non-FUSE) fs so the FUSE check can't mask
+			// a followed symlink.
