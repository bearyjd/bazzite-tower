@@ -0,0 +1,194 @@
+package nftables
+
+import (
+	"errors"
+	"github.com/google/nftables"
+	"testing"
+)
+
+func policyChain(table, name string, policy nftables.ChainPolicy) *nftables.Chain {
+	return &nftables.Chain{Name: name, Table: &nftables.Table{Name: table, Family: nftables.TableFamilyINet}, Type: nftables.ChainTypeFilter, Hooknum: nftables.ChainHookInput, Priority: nftables.ChainPriorityFilter, Policy: &policy}
+}
+
+func TestPolicyJournalDoesNotTouchUnmodifiedProtectedForeignChains(t *testing.T) {
+	j := &policyJournal{}
+	foreign := policyChain("firewalld", "filter_INPUT", nftables.ChainPolicyAccept)
+	j.queued(foreign, copyChain(foreign))
+	j.committed(true)
+	if err := j.restore(func() ([]*nftables.Chain, error) {
+		t.Fatal("unowned journal should not even list foreign chains")
+		return nil, nil
+	}, func(*nftables.Chain) { t.Fatal("wrote protected foreign chain") }, func() error { t.Fatal("empty commit"); return nil }); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestPolicyJournalRestoresOnlyActuallyCommittedChange(t *testing.T) {
+	j := &policyJournal{}
+	original := policyChain("custom", "input", nftables.ChainPolicyAccept)
+	applied := copyChain(original)
+	*applied.Policy = nftables.ChainPolicyDrop
+	j.queued(original, applied)
+	j.committed(true)
+	*original.Policy = nftables.ChainPolicyDrop // prove saved snapshot owns policy value
+	foreign := policyChain("firewalld", "owner,persist", nftables.ChainPolicyAccept)
+	writes, commits := 0, 0
+	err := j.restore(func() ([]*nftables.Chain, error) { return []*nftables.Chain{foreign, applied}, nil }, func(c *nftables.Chain) {
+		writes++
+		if c.Table.Name != "custom" || *c.Policy != nftables.ChainPolicyAccept {
+			t.Fatal("wrong restoration")
+		}
+	}, func() error { commits++; return nil })
+	if err != nil || writes != 1 || commits != 1 {
+		t.Fatalf("err=%v writes=%d commits=%d", err, writes, commits)
+	}
+	if len(j.applied) != 0 {
+		t.Fatal("restoration not consumed")
+	}
+}
+
+func TestPolicyJournalPreservesAdministratorChangesAndDeletedChains(t *testing.T) {
+	for _, change := range []string{"policy", "definition", "deleted"} {
+		t.Run(change, func(t *testing.T) {
+			j := &policyJournal{}
+			before := policyChain("custom", "input", nftables.ChainPolicyAccept)
+			after := copyChain(before)
+			*after.Policy = nftables.ChainPolicyDrop
+			j.queued(before, after)
+			j.committed(true)
+			current := copyChain(after)
+			switch change {
+			case "policy":
+				*current.Policy = nftables.ChainPolicyAccept
+			case "definition":
+				current.Type = nftables.ChainTypeRoute
+			case "deleted":
+				current = nil
+			}
+			err := j.restore(func() ([]*nftables.Chain, error) {
+				if current == nil {
+					return nil, nil
+				}
+				return []*nftables.Chain{current}, nil
+			}, func(*nftables.Chain) { t.Fatal("overwrote administrator change") }, func() error { t.Fatal("empty flush"); return nil })
+			if err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func TestPolicyJournalFailedCommitDoesNotAcquireOwnership(t *testing.T) {
+	j := &policyJournal{}
+	before := policyChain("custom", "input", nftables.ChainPolicyAccept)
+	after := copyChain(before)
+	*after.Policy = nftables.ChainPolicyDrop
+	j.queued(before, after)
+	j.committed(false)
+	if len(j.applied) != 0 || len(j.pending) != 0 {
+		t.Fatal("failed batch became owned")
+	}
+}
+
+func TestPolicyJournalRestorationFailureRetainsOwnership(t *testing.T) {
+	j := &policyJournal{}
+	before := policyChain("custom", "input", nftables.ChainPolicyAccept)
+	after := copyChain(before)
+	*after.Policy = nftables.ChainPolicyDrop
+	j.queued(before, after)
+	j.committed(true)
+	failure := errors.New("permission denied")
+	if err := j.restore(func() ([]*nftables.Chain, error) { return nil, failure }, func(*nftables.Chain) { t.Fatal("write after read failure") }, func() error { t.Fatal("flush after read failure"); return nil }); err != failure || len(j.applied) != 1 {
+		t.Fatal("read failure lost restoration")
+	}
+	if err := j.restore(func() ([]*nftables.Chain, error) { return []*nftables.Chain{after}, nil }, func(*nftables.Chain) {}, func() error { return failure }); err != failure || len(j.applied) != 1 {
+		t.Fatal("flush failure lost restoration")
+	}
+}
+
+func TestPolicyJournalRepeatedChangesKeepFirstOriginal(t *testing.T) {
+	j := &policyJournal{}
+	before := policyChain("custom", "input", nftables.ChainPolicyAccept)
+	drop := copyChain(before)
+	*drop.Policy = nftables.ChainPolicyDrop
+	j.queued(before, drop)
+	j.committed(true)
+	j.queued(drop, before)
+	j.committed(true)
+	if len(j.applied) != 1 {
+		t.Fatal("missing journal")
+	}
+	writes := 0
+	if err := j.restore(func() ([]*nftables.Chain, error) { return []*nftables.Chain{before}, nil }, func(*nftables.Chain) { writes++ }, func() error { t.Fatal("already restored policy flushed"); return nil }); err != nil || writes != 0 {
+		t.Fatal("wrong repeated-change restoration")
+	}
+}
+
+func TestPolicyJournalTracksFinalSameChainUpdateInOneBatch(t *testing.T) {
+	j := &policyJournal{}
+	accept := policyChain("custom", "input", nftables.ChainPolicyAccept)
+	drop := copyChain(accept)
+	*drop.Policy = nftables.ChainPolicyDrop
+	j.queued(accept, drop)
+	j.committed(true)      // owns Accept baseline, kernel now Drop
+	j.queued(drop, accept) // pending proposal to Accept
+	j.queued(drop, drop)   // final update is a no-op against the kernel, but wins batch
+	j.committed(true)
+	writes := 0
+	if err := j.restore(func() ([]*nftables.Chain, error) { return []*nftables.Chain{drop}, nil }, func(c *nftables.Chain) {
+		writes++
+		if *c.Policy != nftables.ChainPolicyAccept {
+			t.Fatal("lost first baseline")
+		}
+	}, func() error { return nil }); err != nil || writes != 1 {
+		t.Fatal("final batch update not restored")
+	}
+}
+
+func TestPolicyJournalNoOpFinalUpdateCancelsPendingPolicyChange(t *testing.T) {
+	j := &policyJournal{}
+	accept := policyChain("custom", "input", nftables.ChainPolicyAccept)
+	drop := copyChain(accept)
+	*drop.Policy = nftables.ChainPolicyDrop
+	j.queued(accept, drop)
+	j.queued(accept, accept)
+	j.committed(true)
+	if err := j.restore(func() ([]*nftables.Chain, error) { return []*nftables.Chain{accept}, nil }, func(*nftables.Chain) { t.Fatal("unnecessary restore") }, func() error { t.Fatal("empty flush"); return nil }); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestPolicyJournalTypedKeyCannotAliasHyphenatedNames(t *testing.T) {
+	j := &policyJournal{}
+	a := policyChain("c", "a-b", nftables.ChainPolicyAccept)
+	b := policyChain("b-c", "a", nftables.ChainPolicyAccept)
+	ad, bd := copyChain(a), copyChain(b)
+	*ad.Policy = nftables.ChainPolicyDrop
+	*bd.Policy = nftables.ChainPolicyDrop
+	j.queued(a, ad)
+	j.queued(b, bd)
+	j.committed(true)
+	if len(j.applied) != 2 {
+		t.Fatal("distinct identities collided")
+	}
+	writes := 0
+	if err := j.restore(func() ([]*nftables.Chain, error) { return []*nftables.Chain{ad, bd}, nil }, func(*nftables.Chain) { writes++ }, func() error { return nil }); err != nil || writes != 2 {
+		t.Fatal("missing independent restoration")
+	}
+}
+
+func TestPolicyJournalNewChangeAfterAdministratorEditUsesNewBaseline(t *testing.T) {
+	j := &policyJournal{}
+	drop := policyChain("custom", "input", nftables.ChainPolicyDrop)
+	accept := copyChain(drop)
+	*accept.Policy = nftables.ChainPolicyAccept
+	j.queued(drop, accept)
+	j.committed(true)
+	// Administrator changed back to Drop. A no-op Drop write cannot retain our
+	// stale original Drop→Accept ownership and later overwrite another edit.
+	j.queued(drop, drop)
+	j.committed(true)
+	if len(j.applied) != 0 {
+		t.Fatal("kept stale administrator ownership")
+	}
+}
