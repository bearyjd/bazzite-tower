@@ -0,0 +1,78 @@
+package main
+
+import (
+	"errors"
+	"os"
+	"syscall"
+	"testing"
+	"time"
+)
+
+type failingReader struct {
+	failed chan struct{}
+	err    error
+}
+
+func (r *failingReader) ReaderFailed() <-chan struct{} { return r.failed }
+func (r *failingReader) ReaderErr() error              { return r.err }
+
+func TestReaderFailureRequestsShutdown(t *testing.T) {
+	healthy := &failingReader{failed: make(chan struct{})}
+	dead := &failingReader{failed: make(chan struct{}), err: errors.New("queue 1 reader stopped (errno=5)")}
+	got := make(chan error, 2)
+	watchQueueReaders(make(chan struct{}), func(err error) { got <- err }, healthy, dead)
+	close(dead.failed)
+	select {
+	case err := <-got:
+		if err != dead.err {
+			t.Fatalf("shutdown requested for the wrong reader: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("reader failure did not request shutdown")
+	}
+	select {
+	case err := <-got:
+		t.Fatalf("healthy reader requested shutdown: %v", err)
+	case <-time.After(50 * time.Millisecond):
+	}
+}
+
+func TestFailingShutdownUsesSignalPathAndFailsExit(t *testing.T) {
+	saved := sigChan
+	defer func() { sigChan = saved; readerFailed.Store(false) }()
+	sigChan = make(chan os.Signal, 1)
+	requestFailingShutdown(errors.New("queue 1 reader stopped"))
+	if sig := <-sigChan; sig != syscall.SIGTERM {
+		t.Fatalf("shutdown requested with %v", sig)
+	}
+	if !readerFailed.Load() {
+		t.Fatal("reader failure would exit 0")
+	}
+	// A pending signal already owns the shutdown; the request must not block.
+	sigChan <- syscall.SIGINT
+	done := make(chan struct{})
+	go func() { requestFailingShutdown(errors.New("repeat queue reader stopped")); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("failing shutdown blocked behind a pending signal")
+	}
+	if sig := <-sigChan; sig != syscall.SIGINT {
+		t.Fatalf("pending signal replaced by %v", sig)
+	}
+}
+
+func TestReaderWatchStopsWithDaemon(t *testing.T) {
+	reader := &failingReader{failed: make(chan struct{})}
+	done := make(chan struct{})
+	got := make(chan error, 1)
+	watchQueueReaders(done, func(err error) { got <- err }, reader)
+	// Both may be ready when the watcher selects; shutdown must still win.
+	close(done)
+	close(reader.failed)
+	select {
+	case err := <-got:
+		t.Fatalf("reader exit during daemon shutdown requested another shutdown: %v", err)
+	case <-time.After(50 * time.Millisecond):
+	}
+}
