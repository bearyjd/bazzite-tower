{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "schedule:weekly"
  ],
  "dockerfile": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/build-disk\\.yml$/", "/^Justfile$/"],
      "matchStrings": ["(?<depName>quay.io/centos-bootc/bootc-image-builder)@(?<currentDigest>sha256:[a-f0-9]+)"],
      "currentValueTemplate": "latest",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
