{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "schedule:weekly"
  ],
  "dockerfile": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/build-disk\\.yml$/", "/^Justfile$/"],
      "matchStrings": ["(?<depName>quay.io/centos-bootc/bootc-image-builder)@(?<currentDigest>sha256:[a-f0-9]+)"],
      "currentValueTemplate": "latest",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["ghcr.io/ublue-os/bazzite-nvidia-open"],
      "enabled": false
    },
    {
      "description": "The snitchwatch-prep builder digest is pinned in Containerfile, snitchwatch-system-pins.json, snitchwatch-system-daemon-pins.json and the snitchwatch release builder; bump it only as a deliberate coordinated change.",
      "matchPackageNames": ["registry.fedoraproject.org/fedora"],
      "enabled": false
    }
  ]
}
