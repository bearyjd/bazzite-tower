{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "schedule:weekly"
  ],
  "dockerfile": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Keep branch-pinned GitHub Actions immutable while following their source branch.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["osbuild/bootc-image-builder-action"],
      "pinDigests": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/build-disk\\.yml$/", "/^Justfile$/"],
      "matchStrings": ["(?<depName>quay.io/centos-bootc/bootc-image-builder)@(?<currentDigest>sha256:[a-f0-9]+)"],
      "currentValueTemplate": "latest",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/build\\.yml$/"],
      "matchStrings": ["syft-version:\\s*(?<currentValue>v?[0-9.]+)\\s+#\\s*renovate:\\s*datasource=github-releases\\s+depName=(?<depName>[^\\s]+)"],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
