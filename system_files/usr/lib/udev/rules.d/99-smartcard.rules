# Alcor Micro smartcard reader (058f:9540).
#
# Was MODE="0666" in /etc — world read/write on the device node. uaccess is the
# modern equivalent that scopes access to the logged-in local session instead of
# every account on the machine.
SUBSYSTEM=="usb", ATTR{idVendor}=="058f", ATTR{idProduct}=="9540", TAG+="uaccess"
