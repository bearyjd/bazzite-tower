#!/usr/bin/env bash
# Reporting only: no elevation, host writes, network requests or service changes.
# Every external probe is finite; unavailable/denied probes are explicitly unknown.
set +e
set -o pipefail
export LC_ALL=C

case "${1:-}" in
    "") diagnostics=false ;;
    --diagnostics) diagnostics=true ;;
    *) echo "Usage: bazzite-tower-health [--diagnostics]" >&2; exit 2 ;;
esac
if (( $# > 1 )); then
    echo "Usage: bazzite-tower-health [--diagnostics]" >&2
    exit 2
fi

available() { command -v "$1" >/dev/null 2>&1; }

# Bound both command duration and bytes before formatting. Failed/partial probes
# are never presented as a clean bill of health. No temporary files are written.
probe() {
    local label="$1" output rc truncated=false
    shift
    printf '  %s:\n' "$label"
    if ! available "$1" || ! available timeout; then
        echo "    UNKNOWN (tool unavailable)"
        return
    fi
    # Preserve trailing newlines with a sentinel, retaining the pipeline status.
    # The extra byte detects truncation even if a buffered writer exits zero.
    output=$(timeout 8s "$@" 2>&1 | head -c 12289; rc=$?; printf '.'; exit "$rc")
    rc=$?
    output=${output%.}
    if (( ${#output} > 12288 )); then
        truncated=true
        output=${output:0:12288}
    fi
    if "$truncated" || (( rc != 0 )) || [[ "$output" =~ [Pp]ermission\ denied|[Aa]ccess\ denied|[Oo]peration\ not\ permitted|not\ seeing\ messages|No\ journal\ files ]]; then
        printf '    UNKNOWN (probe failed, denied, timed out or truncated; status=%s)\n' "$rc"
    elif [[ -z "$output" ]]; then
        echo "    no entries returned (successful query)"
    fi
    printf '%s\n' "$output" | tr -d '\000-\010\013-\037\177' | awk 'NR <= 20 {print "    " substr($0, 1, 240); if (length($0) > 240) clipped=1} NR == 21 {clipped=1} END {if (clipped) print "    [display truncated]"}'
    if "$truncated"; then echo "    [display truncated] (byte limit)"; fi
}

unit_status() {
    local unit="$1" enabled active
    enabled=$(timeout 8s systemctl is-enabled "$unit" 2>/dev/null)
    active=$(timeout 8s systemctl is-active "$unit" 2>/dev/null)
    # systemctl uses nonzero status for legitimate disabled/inactive units.
    case "$enabled" in enabled|disabled|static|masked|indirect|generated|alias|enabled-runtime|linked|linked-runtime) ;; *) enabled=UNKNOWN ;; esac
    case "$active" in active|inactive|failed|activating|deactivating|reloading) ;; *) active=UNKNOWN ;; esac
    printf '  %-36s enabled=%-10s active=%s\n' "$unit" "$enabled" "$active"
}

# rpm-ostree works without root on bootc hosts where bootc status is privileged.
# Select identity fields only: never print package manifests or local config.
image_identity() {
    local data
    if ! available rpm-ostree || ! available python3 || ! available timeout; then
        echo "  Booted/staged image: UNKNOWN (rpm-ostree/python3/timeout unavailable)"
        return
    fi
    if ! data=$(timeout 8s rpm-ostree status --json 2>/dev/null | head -c 2097153); then
        echo "  Booted/staged image: UNKNOWN (rpm-ostree status failed or denied)"
        return
    fi
    printf '%s' "$data" | python3 -c '
import json, sys
try:
    data = sys.stdin.read(2097153)
    if len(data) > 2097152:
        raise ValueError("identity input exceeds 2 MiB")
    deployments = json.loads(data)["deployments"]
    if not isinstance(deployments, list) or not deployments:
        raise ValueError("missing deployments")
    for name in ("booted", "staged"):
        matches = [d for d in deployments if d.get(name) is True]
        if not matches:
            print("  " + name + (": none reported" if name == "staged" else ": UNKNOWN (not reported)"))
            continue
        if len(matches) != 1:
            raise ValueError("ambiguous deployment")
        deployment = matches[0]
        print("  " + name + ":")
        for key in ("container-image-reference", "version", "checksum"):
            value = deployment.get(key)
            if isinstance(value, str):
                value = "".join(c for c in value if c.isprintable())[:400]
            else:
                value = "UNKNOWN"
            label = "ostree-checksum (not container digest)" if key == "checksum" else key
            print("    " + label + "=" + value)
except (ValueError, KeyError, TypeError, AttributeError):
    print("  Booted/staged image: UNKNOWN (unrecognized rpm-ostree status)")
'
}

# The OpenSnitch daemon falls back to /proc silently when its eBPF modules fail to
# load, so the configured method is not evidence. The runtime check reads
# /proc/<pid>/fd of a root daemon: unprivileged health reports UNKNOWN, never a
# guess. Only its final RESULT line is shown.
ebpf_check=/usr/libexec/bazzite-tower-opensnitch-ebpf-check
ebpf_runtime() {
    local output rc result
    echo "  OpenSnitch eBPF runtime (is the daemon really using eBPF):"
    if [[ "$(id -u 2>/dev/null)" != 0 ]]; then
        echo "    UNKNOWN (needs root; run $ebpf_check --runtime as root)"
        return
    fi
    if ! available "$ebpf_check" || ! available timeout; then
        echo "    UNKNOWN (tool unavailable)"
        return
    fi
    output=$(timeout 8s "$ebpf_check" --runtime 2>&1)
    rc=$?
    result=$(printf '%s\n' "$output" | tail -n 1 | tr -d '\000-\010\013-\037\177' | cut -c1-240)
    if [[ "$result" == "RESULT: "* ]]; then
        printf '    %s\n' "$result"
    else
        printf '    UNKNOWN (no RESULT line; status=%s)\n' "$rc"
    fi
}

# User services: a crash-looping user unit cycles activating/auto-restart and is
# never listed by `--failed`, so the probe reads ActiveState/SubState/NRestarts.
# Only unit names, state and restart counts are shown: never unit contents.
US_RESTART_THRESHOLD=20
US_MAX_LISTED=10
us_cmd=()

# Address the INVOKING user's manager: plain --user when unprivileged, otherwise
# --machine=<user>@.host for SUDO_USER (or the PKEXEC_UID owner). Root alone has no target.
us_resolve() {
    local user=${SUDO_USER:-}
    if [[ "$(id -u 2>/dev/null)" != 0 ]]; then
        us_cmd=(systemctl --user)
        return 0
    fi
    if [[ -z "$user" && "${PKEXEC_UID:-}" =~ ^[0-9]+$ ]]; then
        user=$(id -nu "$PKEXEC_UID" 2>/dev/null)
    fi
    [[ "$user" =~ ^[A-Za-z_][A-Za-z0-9_.-]*$ && "$user" != root ]] || return 1
    us_cmd=(systemctl --user "--machine=$user@.host")
}

# $1 = `systemctl show` blocks.
us_evaluate() {
    printf '%s\n' "$1" | awk -v thr="$US_RESTART_THRESHOLD" -v max="$US_MAX_LISTED" '
        BEGIN { RS = ""; FS = "\n" }
        {
            id = ""; st = ""; ss = ""; n = 0
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^Id=/) id = substr($i, 4)
                else if ($i ~ /^ActiveState=/) st = substr($i, 13)
                else if ($i ~ /^SubState=/) ss = substr($i, 10)
                else if ($i ~ /^NRestarts=[0-9]+$/) n = substr($i, 11) + 0
            }
            if (id == "") next
            seen++
            why = ""
            if (st == "failed") why = "failed"
            else if (st == "activating" && ss == "auto-restart") why = "restart loop"
            else if (n > thr) why = "many restarts"
            if (why == "") next
            flagged++
            gsub(/[^A-Za-z0-9@._:\\-]/, "?", id); gsub(/[^a-z-]/, "?", st); gsub(/[^a-z-]/, "?", ss)
            if (flagged <= max) printf "    PROBLEM %s: NRestarts=%d state=%s/%s (%s)\n", id, n, st, ss, why
        }
        END {
            if (!seen) print "    UNKNOWN (user manager returned no parseable unit state)"
            else if (!flagged) printf "    none: %d user services checked, no failed, restart-looping or >%d restarts\n", seen, thr
            else if (flagged > max) printf "    [%d more not shown]\n", flagged - max
        }'
}

us_report() {
    local list out names
    echo "  User services (invoking user's manager; failed, activating/auto-restart, NRestarts > $US_RESTART_THRESHOLD):"
    if ! available systemctl || ! available timeout; then
        echo "    UNKNOWN (tool unavailable)"
        return
    fi
    if ! us_resolve; then
        echo "    UNKNOWN (no invoking non-root user; run via sudo ujust tower-health)"
        return
    fi
    if ! list=$(timeout 8s "${us_cmd[@]}" list-units --all --type=service --no-legend --plain --no-pager 2>/dev/null); then
        echo "    UNKNOWN (user manager unreachable)"
        return
    fi
    mapfile -t names < <(awk '$1 ~ /^[A-Za-z0-9@._:\\-]+\.service$/ {print $1}' <<<"$list" | head -n 300)
    if (( ${#names[@]} == 0 )); then
        echo "    none (0 user services loaded)"
        return
    fi
    if ! out=$(timeout 8s "${us_cmd[@]}" show -p Id -p ActiveState -p SubState -p NRestarts --no-pager -- "${names[@]}" 2>/dev/null); then
        echo "    UNKNOWN (user manager unreachable)"
        return
    fi
    us_evaluate "$out"
}

label_status() {
    local path="$1"
    probe "$path current label (no contents)" ls -Zd -- "$path"
    probe "$path expected label under installed policy" matchpathcon -n "$path"
}

echo "== bazzite-tower health (reporting only) =="
echo "UNKNOWN means unavailable evidence, never healthy. No network or state changes."
echo
echo "== Deployment and running versions =="
image_identity
probe "Running kernel" uname -r
probe "Loaded NVIDIA module version" cat /sys/module/nvidia/version
probe "Installed kernel/NVIDIA/firmware packages (may differ from loaded versions)" rpm -q kernel-core nvidia-driver kmod-nvidia linux-firmware microcode_ctl
probe "Running CPU microcode revision" awk '/^microcode[[:space:]]*:/ {print; exit}' /proc/cpuinfo
probe "BIOS version/date (no serial numbers)" cat /sys/class/dmi/id/bios_version /sys/class/dmi/id/bios_date
probe "Suspend mode" cat /sys/power/mem_sleep

echo
echo "== Optional host services =="
for unit in docker.socket docker.service cockpit.socket waydroid-container.service tailscaled.service; do
    unit_status "$unit"
done
echo "  Docker, Cockpit, and Waydroid are opt-in; tailscaled needs owner enrollment."
echo
echo "== Monitoring and failed services =="
for unit in smartd.service rasdaemon.service bazzite-tower-power-tuning.service logrotate.service; do
    unit_status "$unit"
done
ebpf_runtime
probe "Failed system services (up to 20 displayed)" systemctl --failed --type=service --no-legend --plain --no-pager
us_report

echo
echo "== MCE / memory evidence =="
probe "Kernel HardwareCorrupted (kB; not a full hardware verdict)" awk '/^HardwareCorrupted:/ {found=1; print} END {if (!found) exit 1}' /proc/meminfo
probe "RAS recorded summary (database lifetime, not necessarily this boot)" ras-mc-ctl --summary
probe "Recent matching kernel evidence, current boot (last 12 matches)" journalctl -k -b 0 --no-pager -o cat -n 12 --grep='mce:|Machine check|Hardware Error|EDAC|Memory failure|RAS:|[Ss]oft.offlin'
probe "Decoded rasdaemon journal evidence, current boot (last 12 records)" journalctl -u rasdaemon.service -b 0 --no-pager -o cat -n 12
echo "  Zero EDAC/HardwareCorrupted counts do not exclude DRAM faults. Corrected does not mean harmless."

echo
echo "== SELinux and local override evidence =="
probe "SELinux mode" getenforce
label_status /var/log/boot.log
path=/etc/systemd/system/logrotate.service.d
if [[ -e "$path" || -L "$path" ]]; then
    printf '  Local configuration path present: %s (contents not read)\n' "$path"
elif [[ -r "${path%/*}" && -x "${path%/*}" ]]; then
    printf '  Local configuration path absent: %s\n' "$path"
else
    printf '  Local configuration path UNKNOWN (parent inaccessible/missing): %s\n' "$path"
fi

echo
echo "== Firmware and security availability =="
probe "bootc version" bootc --version
probe "rpm-ostree version" rpm-ostree --version
probe "Secure Boot" mokutil --sb-state
# The security command can auto-upload HSI reports under local remote policy.
# Version-only availability avoids that implicit network/write path.
probe "Firmware tool availability (version only)" fwupdmgr --version

# Boot-chain baseline: observation only. Each probe prints PASS, WARN or UNKNOWN;
# UNKNOWN (needs root / tool missing / unreadable) is never promoted to PASS, and
# WARN means "not enabled", not a fault: the repo does not require any of these.
# TOWER_HEALTH_FSROOT only prefixes /sys and /dev so fixtures can fake them.
bc_root="${TOWER_HEALTH_FSROOT:-}"
bc_crypt_name=""
bc_crypt_backing=""
bc_tpm_present=false

bc_report() { printf '  %-30s %s\n' "$1:" "$2"; }

# $1 = mokutil-style text; prints the verdict.
bc_sb_decide() {
    case "$1" in
        *"validation is disabled"*) echo "WARN enabled but shim validation is disabled" ;;
        *"SecureBoot enabled"*) echo "PASS enabled" ;;
        *"SecureBoot disabled"*) echo "WARN disabled (not enforced)" ;;
        *) echo "UNKNOWN (unrecognized Secure Boot state)" ;;
    esac
}

bc_secure_boot() {
    local out f raw
    if [[ ! -d "$bc_root/sys/firmware/efi" ]]; then
        bc_report "Secure Boot" "WARN not an EFI boot (legacy BIOS): Secure Boot cannot be active"
        return
    fi
    if available mokutil && available timeout && out=$(timeout 8s mokutil --sb-state 2>&1); then
        bc_report "Secure Boot" "$(bc_sb_decide "$(printf '%s' "$out" | tr -d '\000-\010\013-\037\177' | head -c 400)")"
        return
    fi
    # Fallback: EFI variable = 4 attribute bytes then one data byte (1 = enabled).
    for f in "$bc_root"/sys/firmware/efi/efivars/SecureBoot-*; do
        [[ -r "$f" ]] || continue
        raw=$(od -An -tu1 -- "$f" 2>/dev/null | tr -s ' \n' ' ')
        raw=${raw% }
        case "${raw##* }" in
            1) bc_report "Secure Boot" "$(bc_sb_decide "SecureBoot enabled")" ; return ;;
            0) bc_report "Secure Boot" "$(bc_sb_decide "SecureBoot disabled")" ; return ;;
        esac
    done
    bc_report "Secure Boot" "UNKNOWN (mokutil failed/missing and EFI variable unreadable)"
}

bc_lockdown() {
    local raw mode
    if ! raw=$(head -c 256 -- "$bc_root/sys/kernel/security/lockdown" 2>/dev/null) || [[ -z "$raw" ]]; then
        bc_report "Kernel lockdown" "UNKNOWN (securityfs lockdown file unreadable)"
        return
    fi
    mode=${raw#*\[}
    mode=${mode%%\]*}
    case "$mode" in
        integrity|confidentiality|confidential) bc_report "Kernel lockdown" "PASS $mode" ;;
        none) bc_report "Kernel lockdown" "WARN none (not enforced)" ;;
        *) bc_report "Kernel lockdown" "UNKNOWN (unrecognized: ${raw:0:60})" ;;
    esac
}

bc_root_encryption() {
    local mnt src chain t n p seen=false out ctype cipher
    for mnt in /sysroot /; do
        src=$(timeout 8s findmnt -no SOURCE "$mnt" 2>/dev/null | head -n 1)
        src=${src%%\[*}
        [[ "$src" == /dev/* ]] && break
        src=""
    done
    if ! available findmnt || ! available lsblk || ! available timeout; then
        bc_report "Root encryption" "UNKNOWN (findmnt/lsblk unavailable)"
        return
    fi
    if [[ -z "$src" ]]; then
        bc_report "Root encryption" "UNKNOWN (root source is not a block device)"
        return
    fi
    # lsblk -s walks from the root device down through its ancestors (lvm, crypt, part).
    if ! chain=$(timeout 8s lsblk -nrso TYPE,NAME,PATH "$src" 2>/dev/null) || [[ -z "$chain" ]]; then
        bc_report "Root encryption" "UNKNOWN (lsblk could not describe $src)"
        return
    fi
    while read -r t n p; do
        if "$seen" && [[ -z "$bc_crypt_backing" ]]; then bc_crypt_backing=$p; fi
        if [[ "$t" == crypt && -z "$bc_crypt_name" ]]; then bc_crypt_name=$n; seen=true; fi
    done <<<"$chain"
    if [[ -z "$bc_crypt_name" ]]; then
        bc_report "Root encryption" "WARN root is not on a dm-crypt device (unencrypted)"
        return
    fi
    if ! available cryptsetup || ! out=$(timeout 8s cryptsetup status "$bc_crypt_name" 2>&1); then
        bc_report "Root encryption" "UNKNOWN (dm-crypt root, LUKS version unreadable: needs root / cryptsetup missing)"
        return
    fi
    ctype=$(printf '%s\n' "$out" | awk '$1 == "type:" {print $2; exit}' | tr -cd '[:alnum:]')
    cipher=$(printf '%s\n' "$out" | awk '$1 == "cipher:" {print $2; exit}' | tr -cd '[:alnum:]_.:-')
    case "$ctype" in
        LUKS2) bc_report "Root encryption" "PASS LUKS2 (cipher ${cipher:-unknown})" ;;
        LUKS1) bc_report "Root encryption" "WARN LUKS1 (LUKS2 expected; cipher ${cipher:-unknown})" ;;
        PLAIN) bc_report "Root encryption" "WARN plain dm-crypt, no LUKS header (cipher ${cipher:-unknown})" ;;
        *) bc_report "Root encryption" "UNKNOWN (dm-crypt root, unrecognized type)" ;;
    esac
}

bc_tpm() {
    local ver=""
    if [[ -d "$bc_root/sys/class/tpm/tpm0" && -e "$bc_root/dev/tpmrm0" ]]; then
        ver=$(head -c 8 -- "$bc_root/sys/class/tpm/tpm0/tpm_version_major" 2>/dev/null | tr -cd '0-9')
        case "$ver" in
            1) bc_report "TPM" "WARN TPM 1.2 only (TPM2 needed)" ;;
            2) bc_tpm_present=true; bc_report "TPM" "PASS TPM2: tpm0 and /dev/tpmrm0 present" ;;
            *) bc_tpm_present=true; bc_report "TPM" "UNKNOWN tpm0 and /dev/tpmrm0 present but TPM version unreadable" ;;
        esac
    elif [[ -d "$bc_root/sys/class/tpm/tpm0" ]]; then
        bc_report "TPM" "WARN tpm0 present but no /dev/tpmrm0 resource manager"
    else
        bc_report "TPM" "WARN no TPM device (disabled in firmware or absent)"
    fi
}

bc_tpm_keyslot() {
    local dump
    if ! "$bc_tpm_present"; then
        bc_report "TPM2 LUKS keyslot" "WARN no usable TPM2, nothing can be enrolled"
    elif [[ -z "$bc_crypt_backing" ]]; then
        bc_report "TPM2 LUKS keyslot" "UNKNOWN (no LUKS backing device identified)"
    elif [[ "$(id -u 2>/dev/null)" != 0 ]]; then
        bc_report "TPM2 LUKS keyslot" "UNKNOWN (needs root; rerun tower-health as root)"
    elif ! available cryptsetup || ! dump=$(timeout 8s cryptsetup luksDump "$bc_crypt_backing" 2>/dev/null); then
        bc_report "TPM2 LUKS keyslot" "UNKNOWN (luksDump failed or cryptsetup missing)"
    elif ! grep -Eq '^Version:[[:space:]]+2' <<<"$dump"; then
        bc_report "TPM2 LUKS keyslot" "WARN not LUKS2, no token metadata for TPM2 enrollment"
    elif grep -Eq '^[[:space:]]*[0-9]+:[[:space:]]*systemd-tpm2' <<<"$dump"; then
        bc_report "TPM2 LUKS keyslot" "PASS systemd-tpm2 token enrolled"
    else
        bc_report "TPM2 LUKS keyslot" "WARN no systemd-tpm2 token (not enrolled)"
    fi
}

echo
echo "== Boot-chain baseline (observation only) =="
bc_secure_boot
bc_lockdown
bc_root_encryption
bc_tpm
bc_tpm_keyslot
echo "  WARN = not enabled (visibility only, nothing was changed); UNKNOWN = not determinable here."

if "$diagnostics"; then
    echo
    echo "== Bounded fresh-boot / resume excerpts (current boot only) =="
    echo "  Last matching records only; absence is not proof of a successful resume."
    probe "Kernel resume/GPU/audio/firmware evidence (last 20 matches)" journalctl -k -b 0 --no-pager -o short-monotonic -n 20 --grep='PM: suspend|PM: resume|suspend entry|suspend exit|i915.*(error|fail|reset|timeout)|NVRM:|nvidia.*(error|fail)|iwlwifi.*(firmware|error)|sof.*(error|fail)|microcode:'
    probe "Suspend unit outcome" systemctl show systemd-suspend.service -p ActiveState -p Result -p ExecMainStatus
    probe "Decoded recorded RAS errors (bounded display)" ras-mc-ctl --errors
fi

echo
echo "No host state changed. Privileged follow-up and interpretation: docs/RUNBOOK.md."
exit 0
