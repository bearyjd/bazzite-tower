#!/usr/bin/env python3
"""Check RPM-supplied eBPF object packaging; this cannot prove kernel loading."""
import argparse
import os
from pathlib import Path
import stat
import struct
import sys

OBJECTS = ('opensnitch.o', 'opensnitch-procs.o', 'opensnitch-dns.o')


def verify(root):
    for name in OBJECTS:
        path = Path(root) / 'usr/lib/opensnitchd/ebpf' / name
        if not stat.S_ISREG(path.lstat().st_mode):
            raise ValueError(f'{path}: expected a regular file, not a symlink')
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, 'rb') as source:
            if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
                raise ValueError(f'{path}: expected a regular file')
            header = source.read(64)
        if (len(header) != 64 or header[:7] != b'\x7fELF\x02\x01\x01'
                or struct.unpack_from('<HHI', header, 16) != (1, 247, 1)
                or struct.unpack_from('<H', header, 52)[0] != 64):
            raise ValueError(f'{path}: expected a nonempty ELF64 little-endian relocatable BPF object')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root', default='/')
    args = parser.parse_args()
    try:
        verify(args.root)
    except (OSError, ValueError) as error:
        print(f'FAIL: {error}', file=sys.stderr)
        return 1
    print('PASS: all three OpenSnitch eBPF objects have ELF BPF headers (runtime unverified)')
    return 0


if __name__ == '__main__':
    sys.exit(main())
